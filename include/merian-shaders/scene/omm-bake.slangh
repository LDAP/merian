#pragma once

#ifdef __cplusplus
#include "merian-shaders/scene/scene-data.slangh"
#include <cstdint>
#define MERIAN_OMM_FUNC inline
#else
#define MERIAN_OMM_FUNC
#endif

namespace merian {

#define MERIAN_OMM_FORMAT_4_STATE 2

#define MERIAN_OMM_MAX_SPAN 180

#define MERIAN_OMM_TARGET_EDGE_TEXELS 4.0

#define MERIAN_OMM_TEXEL_SLACK 0.125

#ifdef __cplusplus
using OmmDataAddress = vk::DeviceAddress;
#else
typealias OmmDataAddress = uint*;
#endif

struct OmmBakeJob {
    GeometryData geometry;
    OmmDataAddress data;
    uint32_t subdivision_level;
    uint32_t _pad;
};

struct OmmBakeBlock {
    uint32_t job_index;
    uint32_t primitive_id;
    uint32_t data_word_offset;
};

#ifdef __cplusplus
static_assert(sizeof(OmmBakeBlock) == 12, "OmmBakeBlock layout mismatch");
static_assert(sizeof(OmmBakeJob) == sizeof(GeometryData) + 16, "OmmBakeJob layout mismatch");
#endif

struct OmmMicroTriangle {
    float2 p0;
    float2 p1;
    float2 p2;
};

MERIAN_OMM_FUNC uint32_t omm_extract_even_bits(uint32_t x) {
    x &= 0x55555555;
    x = (x | (x >> 1)) & 0x33333333;
    x = (x | (x >> 2)) & 0x0f0f0f0f;
    x = (x | (x >> 4)) & 0x00ff00ff;
    x = (x | (x >> 8)) & 0x0000ffff;
    return x;
}

MERIAN_OMM_FUNC uint32_t omm_prefix_eor(uint32_t x) {
    x ^= x >> 1;
    x ^= x >> 2;
    x ^= x >> 4;
    x ^= x >> 8;
    return x;
}

// Space-filling curve of the Vulkan specification, "Ray Opacity Micromap".
MERIAN_OMM_FUNC OmmMicroTriangle omm_index_to_bary(const uint32_t index, const uint32_t level) {
    OmmMicroTriangle t;
    if (level == 0) {
        t.p0 = float2(0, 0);
        t.p1 = float2(1, 0);
        t.p2 = float2(0, 1);
        return t;
    }

    const uint32_t b0 = omm_extract_even_bits(index);
    const uint32_t b1 = omm_extract_even_bits(index >> 1);
    const uint32_t fx = omm_prefix_eor(b0);
    const uint32_t fy = omm_prefix_eor(b0 & ~b1);
    const uint32_t tt = fy ^ b1;

    const uint32_t mask = (1u << level) - 1;
    uint32_t iu = ((fx & ~tt) | (b0 & ~tt) | (~b0 & ~fx & tt)) & mask;
    uint32_t iv = (fy ^ b0) & mask;
    const uint32_t iw = ((~fx & ~tt) | (b0 & ~tt) | (~b0 & fx & tt)) & mask;

    const bool upright = ((iu ^ iv ^ iw) & 1) != 0;
    if (!upright) {
        iu += 1;
        iv += 1;
    }

    const float scale = 1.f / float(1u << level);
    const float step = upright ? scale : -scale;
    const float u = float(iu) * scale;
    const float v = float(iv) * scale;
    t.p0 = float2(u, v);
    t.p1 = float2(u + step, v);
    t.p2 = float2(u, v + step);
    return t;
}

MERIAN_OMM_FUNC float omm_edge_area(const float2 a, const float2 b, const float2 c) {
    return (c.x - a.x) * (b.y - a.y) - (c.y - a.y) * (b.x - a.x);
}

// Akenine-Moeller and Aila 2005, "Conservative and Tiled Rasterization Using a Modified
// Triangle Setup".
MERIAN_OMM_FUNC bool
omm_box_inside_edge(const float2 a, const float2 b, const float2 corner, const float2 extent) {
    const float2 normal = float2(b.y - a.y, a.x - b.x);
    const float offset = -dot(normal, a);
    const float2 bias = float2(normal.x > 0.f ? 0.f : normal.x, normal.y > 0.f ? 0.f : normal.y);
    return dot(normal, corner) + offset + dot(bias, extent) < 0.f;
}

struct OmmTexelFootprint {
    bool bounded;
    int2 first;
    int2 last;
    float2 a;
    float2 b;
    float2 c;
};

MERIAN_OMM_FUNC OmmTexelFootprint omm_texel_footprint(const float2 p0,
                                                      const float2 p1,
                                                      const float2 p2) {
    OmmTexelFootprint footprint;
    const float2 aabb_min = min(p0, min(p1, p2)) - float(MERIAN_OMM_TEXEL_SLACK);
    const float2 aabb_max = max(p0, max(p1, p2)) + float(MERIAN_OMM_TEXEL_SLACK);
    footprint.bounded = aabb_max.x - aabb_min.x < float(MERIAN_OMM_MAX_SPAN - 2) &&
                        aabb_max.y - aabb_min.y < float(MERIAN_OMM_MAX_SPAN - 2) &&
                        aabb_min.x > -1e9f && aabb_min.y > -1e9f && aabb_max.x < 1e9f &&
                        aabb_max.y < 1e9f;
    if (!footprint.bounded) {
        return footprint;
    }

    footprint.first = int2(floor(aabb_min));
    footprint.last = int2(floor(aabb_max)) + 1;

    const bool flip = omm_edge_area(p0, p1, p2) > 0.f;
    footprint.a = p0;
    footprint.b = flip ? p2 : p1;
    footprint.c = flip ? p1 : p2;
    return footprint;
}

MERIAN_OMM_FUNC bool
omm_footprint_reads(const OmmTexelFootprint footprint, const int x, const int y) {
    const float2 corner = float2(float(x), float(y)) - float(1 + MERIAN_OMM_TEXEL_SLACK);
    const float2 extent = float2(float(2 + 2 * MERIAN_OMM_TEXEL_SLACK));
    return omm_box_inside_edge(footprint.a, footprint.b, corner, extent) &&
           omm_box_inside_edge(footprint.b, footprint.c, corner, extent) &&
           omm_box_inside_edge(footprint.c, footprint.a, corner, extent);
}

} // namespace merian
