#pragma once

// On the shader side GeometryData comes from the scene_data module; including it here would
// re-expand it outside the imports it needs.
#ifdef __cplusplus
#include "merian-shaders/scene/scene-data.slangh"
#include <cstdint>
#endif

namespace merian {

// vk::OpacityMicromapFormatEXT::e4State. Two bits per micro-triangle: 0 transparent, 1 opaque,
// 2 and 3 unknown, which is what still reaches the alpha test.
#define MERIAN_OMM_FORMAT_4_STATE 2

// Most texels one micro-triangle is rasterized over. Past this it stays unknown, which bounds both
// the shader's work and what the host has to budget for.
// The span cap and the texel cap have to agree: a micro-triangle that passes the span check must
// fit the texel budget, or its scan is cut short and it can only be left unknown.
#define MERIAN_OMM_MAX_SPAN 180
#define MERIAN_OMM_MAX_TEXELS (MERIAN_OMM_MAX_SPAN * MERIAN_OMM_MAX_SPAN + 1)

// Longest micro-triangle edge the bake aims for, in texels. Small enough that a micro-triangle
// stays inside one cutout feature, large enough to keep the micromaps small.
#define MERIAN_OMM_TARGET_EDGE_TEXELS 4.0

// One mesh whose micromap is being built.
struct OmmBakeJob {
    GeometryData geometry;

    // where this mesh's triangles start in the per-triangle arrays
    uint32_t triangle_offset;
    uint32_t primitive_count;

    uint32_t _pad[2];
};

// What the bake does with one triangle, laid out on the host once its level is known.
struct OmmBakeTriangle {
    uint32_t job_index;
    uint32_t primitive_id;
    uint32_t subdivision_level;
    // where this triangle's states begin in the shared data buffer
    uint32_t data_word_offset;
};

#ifdef __cplusplus
static_assert(sizeof(OmmBakeTriangle) == 16, "OmmBakeTriangle layout mismatch");
static_assert(sizeof(OmmBakeJob) == sizeof(GeometryData) + 16, "OmmBakeJob layout mismatch");
#endif

} // namespace merian
