#pragma once

#ifdef __cplusplus
#include "merian-shaders/scene/light-select.slangh"
#include "merian-shaders/scene/scene-data.slangh"
#else
__exported import merian_shaders.scene.light_select;
import merian_shaders.scene.scene_data;
#endif

namespace merian {

#ifdef __cplusplus
static constexpr uint32_t LIGHT_INVALID_INDEX = 0xFFFFFFFFu;
// the environment map, which has no triangle index
static constexpr uint32_t LIGHT_ENV_INDEX = 0xFFFFFFFEu;
#else
static const uint LIGHT_INVALID_INDEX = 0xFFFFFFFFu;
// the environment map, which has no triangle index
static const uint LIGHT_ENV_INDEX = 0xFFFFFFFEu;
#endif

enum EmissiveTriangleFlags : uint16_t {
    // visible from both sides; the flux sums both faces
    EmissiveTwoSided = 0x1,
};

// One emissive triangle in world space. p0, p1, p2 are wound so that cross(p1 - p0, p2 - p0)
// is the front-facing normal.
struct EmissiveTriangle {
    float3 p0;
    float3 p1;
    float3 p2;
    half2 uv0;
    half2 uv1;
    half2 uv2;
    // radiant flux (luminance); 0 marks a triangle that is never sampled
    float flux;
    GeometryID geometry_id;
    uint32_t primitive_id;
    MaterialID material_id;
    EmissiveTriangleFlags flags;

#ifndef __cplusplus
    float3 get_position(const float3 bary) {
        return bary.x * p0 + bary.y * p1 + bary.z * p2;
    }

    float2 get_uv(const float3 bary) {
        return bary.x * float2(uv0) + bary.y * float2(uv1) + bary.z * float2(uv2);
    }

    // unnormalized front-facing normal, length = 2 * area
    float3 get_scaled_normal() {
        return cross(p1 - p0, p2 - p0);
    }

    bool is_two_sided() {
        return (flags & EmissiveTriangleFlags::EmissiveTwoSided) != 0;
    }
#endif
};

// An emissive geometry as seen by the light update pass.
struct LightGeometry {
    GeometryID geometry_id;
    uint32_t instance_index;
    uint32_t first_triangle;
    uint32_t primitive_count;

#ifdef __cplusplus
    bool operator==(const LightGeometry&) const = default;
#endif
};

#ifdef __cplusplus
static_assert(sizeof(EmissiveTriangle) == 64,
              "EmissiveTriangle must match the Slang scalar layout");
static_assert(sizeof(LightGeometry) == 16, "LightGeometry layout mismatch");
#endif

} // namespace merian
