#include "merian-shaders/scene/micromap.slangh"

namespace merian {

#ifdef __cplusplus
using EmissionAddress = uint64_t;
#else
typealias EmissionAddress = uint*;
#endif

#ifdef __cplusplus
static constexpr uint32_t LIGHT_INVALID_INDEX = 0xFFFFFFFFu;
// the environment map, which has no triangle index
static constexpr uint32_t LIGHT_ENV_INDEX = 0xFFFFFFFEu;
#else
static const uint LIGHT_INVALID_INDEX = 0xFFFFFFFFu;
// the environment map, which has no triangle index
static const uint LIGHT_ENV_INDEX = 0xFFFFFFFEu;
#endif

enum EmissiveTriangleFlags : uint16_t {
    // visible from both sides; the flux sums both faces
    EmissiveTwoSided = 0x1,
    EmissiveAlphaTested = 0x2,
    // at infinity: centroid holds the direction, radius the sine of the angle it covers
    EmissiveDistant = 0x4,
};

// One emissive triangle in world space. p0, p1, p2 are wound so that cross(p1 - p0, p2 - p0)
// is the front-facing normal.
struct EmissiveTriangle {
    float3 p0;
    float3 p1;
    float3 p2;
    half2 uv0;
    half2 uv1;
    half2 uv2;
    // radiant flux (luminance); 0 marks a triangle that is never sampled
    float flux;
    GeometryID geometry_id;
    uint32_t primitive_id;
    MaterialID material_id;
    EmissiveTriangleFlags flags;

#ifndef __cplusplus
    float3 get_position(const float3 bary) {
        return bary.x * p0 + bary.y * p1 + bary.z * p2;
    }

    float2 get_uv(const float3 bary) {
        return bary.x * float2(uv0) + bary.y * float2(uv1) + bary.z * float2(uv2);
    }

    // unnormalized front-facing normal, length = 2 * area
    float3 get_scaled_normal() {
        return cross(p1 - p0, p2 - p0);
    }

    float2 get_barycentrics(const float3 pos) {
        const float3 e1 = p1 - p0;
        const float3 e2 = p2 - p0;
        const float3 v = pos - p0;
        const float d00 = dot(e1, e1);
        const float d01 = dot(e1, e2);
        const float d11 = dot(e2, e2);
        const float d20 = dot(v, e1);
        const float d21 = dot(v, e2);
        return float2(d11 * d20 - d01 * d21, d00 * d21 - d01 * d20) / (d00 * d11 - d01 * d01);
    }

    bool is_two_sided() {
        return (flags & EmissiveTriangleFlags::EmissiveTwoSided) != 0;
    }

    bool is_alpha_tested() {
        return (flags & EmissiveTriangleFlags::EmissiveAlphaTested) != 0;
    }
#endif
};

struct EmissiveRegion {
    EmissionAddress record;
    uint16_t level;
    // vertices 1 and 2 swapped against the mesh
    uint16_t swapped;
    uint32_t count;

#ifndef __cplusplus
    static EmissiveRegion whole() {
        EmissiveRegion region;
        region.record = nullptr;
        region.level = uint16_t(0);
        region.swapped = uint16_t(0);
        region.count = 1;
        return region;
    }

    float get_fraction() {
        return float(count) / float(1u << (2 * uint(level)));
    }

    float3 to_triangle(const float3 bary, const float u) {
        if (record == nullptr)
            return bary;
        uint k = min(uint(u * float(count)), count - 1);
        const uint words = emission_bit_words(level);
        uint bits[EMISSION_MAX_BIT_WORDS];
        for (uint word = 0; word < EMISSION_MAX_BIT_WORDS; word++) {
            bits[word] = word < words ? record[EMISSION_RECORD_BITS + word] : 0u;
        }
        uint chosen_word = 0;
        uint chosen_bits = 0;
        bool found = false;
        for (uint word = 0; word < EMISSION_MAX_BIT_WORDS; word++) {
            const uint set = countbits(bits[word]);
            const bool here = !found && k < set;
            chosen_word = here ? word : chosen_word;
            chosen_bits = here ? bits[word] : chosen_bits;
            k = found || here ? k : k - set;
            found = found || here;
        }
        const uint index = 32 * chosen_word + select_set_bit(chosen_bits, k);
        const MicroTriangle micro = emission_grid_to_bary(index, level);
        const float2 uv = micro.p0 * bary.x + micro.p1 * bary.y + micro.p2 * bary.z;
        const float3 mesh = float3(1.f - uv.x - uv.y, uv);
        return swapped != 0 ? mesh.xzy : mesh;
    }

    bool emits(const float2 mesh_bary) {
        const uint index = emission_grid_index_of(mesh_bary, level);
        return (record[EMISSION_RECORD_BITS + index / 32] & (1u << (index % 32))) != 0;
    }

    bool contains_mesh(const float2 mesh_bary) {
        return record == nullptr || emits(mesh_bary);
    }

    bool contains(const float3 bary) {
        return contains_mesh(swapped != 0 ? bary.zy : bary.yz);
    }
#endif
};

// Stand-in for an emissive triangle, for the passes that only need where it sits and how much it
// emits.
struct EmissiveLightProxy {
    float3 centroid;
    float flux;

#ifndef __cplusplus
    bool is_valid() {
        return flux > 0.f;
    }
#endif
};

// A node of a cut: a sphere, or where distant a cone of directions.
struct LightBound {
    float3 centroid;
    float flux;
    float radius;
    uint32_t flags;

#ifndef __cplusplus
    bool is_distant() {
        return (flags & uint32_t(EmissiveTriangleFlags::EmissiveDistant)) != 0;
    }

    // A zero normal receives from every side; cones widened as in Conty Estevez and Kulla 2018.
    float geometry_term(const float3 pos, const float3 receiver_normal) {
        const bool oriented = any(receiver_normal != 0.f);
        if (is_distant()) {
            const float cos_u = sqrt(max(1.f - radius * radius, 0.f));
            return oriented ? widened_cos(dot(receiver_normal, centroid), cos_u, radius) : 1.f;
        }
        const float3 to_pos = pos - centroid;
        const float dist2 = dot(to_pos, to_pos);
        const float dist = sqrt(dist2);
        const float sin_u = dist > 0.f ? min(radius / dist, 1.f) : 1.f;
        const float cos_u = sqrt(max(1.f - sin_u * sin_u, 0.f));
        const float3 dir = dist > 0.f ? to_pos / dist : float3(0);
        const float receiver =
            oriented ? widened_cos(-dot(receiver_normal, dir), cos_u, sin_u) : 1.f;
        return receiver / max(dist2, radius * radius);
    }

    static float widened_cos(const float cos_theta, const float cos_u, const float sin_u) {
        if (cos_theta >= cos_u)
            return 1.f;
        const float sin_theta = sqrt(max(1.f - cos_theta * cos_theta, 0.f));
        return max(cos_theta * cos_u + sin_theta * sin_u, 0.f);
    }
#endif
};

#ifndef __cplusplus
// Double-float sum (hi, lo).
float2 ff_add(const float2 a, const float2 b) {
    float error;
    const float sum = two_sum(a.x, b.x, error);
    const float e = exact_add(exact_add(error, a.y), b.y);
    const float hi = exact_add(sum, e);
    return float2(hi, exact_sub(e, exact_sub(hi, sum)));
}

float ff_diff(const float2 a, const float2 b) {
    return exact_add(exact_sub(a.x, b.x), exact_sub(a.y, b.y));
}

float range_share(const StructuredBuffer<float2> cdf,
                  const uint first,
                  const uint end,
                  const uint i) {
    const float2 base = first > 0 ? cdf[first - 1] : float2(0);
    const float total = ff_diff(cdf[end - 1], base);
    const float value = ff_diff(cdf[i], i > 0 ? cdf[i - 1] : float2(0));
    return total > 0.f ? max(value, 0.f) / total : 0.f;
}

// Double-float product, with a fused multiply-add for the error of the leading one (Dekker 1971).
float2 ff_mul(const float2 a, const float2 b) {
    const float p = exact_mul(a.x, b.x);
    const float e = exact_add(exact_fma(a.x, b.x, -p), a.x * b.y + a.y * b.x);
    const float hi = exact_add(p, e);
    return float2(hi, exact_sub(e, exact_sub(hi, p)));
}

bool ff_greater(const float2 a, const float2 b) {
    return a.x > b.x || (a.x == b.x && a.y > b.y);
}

// Where the entries of [first, end) are drawn by their share of the range's sum: u is uniform to 48
// bits as two uniform numbers, so even entries far below the range's sum keep their share.
float2 range_threshold(const StructuredBuffer<float2> cdf,
                       const uint first,
                       const uint end,
                       const float2 u) {
    const float2 base = first > 0 ? cdf[first - 1] : float2(0);
    const float2 total = ff_add(cdf[end - 1], -base);
    return ff_add(base, ff_mul(total, float2(u.x, u.y * (1.f / 16777216.f))));
}

uint cdf_bucket(const float value, const float scale, const uint buckets) {
    return min(buckets - 1, uint(value * scale));
}

// search_range from the guide's bucket on (Chen and Asau 1974)
uint search_range_guided(const StructuredBuffer<float2> cdf,
                         const StructuredBuffer<uint> guide,
                         const uint buckets,
                         const uint first,
                         const uint end,
                         const float2 u) {
    const float2 threshold = range_threshold(cdf, first, end, u);
    const uint bucket = cdf_bucket(threshold.x, asfloat(guide[buckets + 1]), buckets);
    uint lo = clamp(guide[bucket], first, end - 1);
    uint hi = clamp(guide[bucket + 1], lo, end - 1);
    while (lo < hi) {
        const uint mid = (lo + hi) >> 1;
        if (ff_greater(cdf[mid], threshold))
            hi = mid;
        else
            lo = mid + 1;
    }
    return lo;
}

uint search_range(const StructuredBuffer<float2> cdf,
                  const uint first,
                  const uint end,
                  const float2 u) {
    const float2 threshold = range_threshold(cdf, first, end, u);
    uint lo = first;
    uint hi = end - 1;
    while (lo < hi) {
        const uint mid = (lo + hi) >> 1;
        if (ff_greater(cdf[mid], threshold))
            hi = mid;
        else
            lo = mid + 1;
    }
    return lo;
}
#endif

// An emissive geometry as seen by the light update pass.
struct LightGeometry {
    GeometryID geometry_id;
    uint32_t instance_index;
    uint32_t first_triangle;
    uint32_t primitive_count;
    // per triangle, in words; null until baked
    EmissionAddress emission_offsets;
    EmissionAddress emission_records;
    uint32_t emission_level;
    uint32_t _pad;

#ifdef __cplusplus
    bool operator==(const LightGeometry&) const = default;
#endif
};

#ifndef __cplusplus
// The geometry a triangle belongs to; the table is ordered by its first triangle.
uint find_light_geometry(const StructuredBuffer<LightGeometry, ScalarDataLayout> geometries,
                         const uint count,
                         const uint triangle) {
    if (count == 0)
        return 0;
    uint lo = 0;
    uint hi = count - 1;
    while (lo < hi) {
        const uint mid = (lo + hi + 1) >> 1;
        if (geometries[mid].first_triangle <= triangle)
            lo = mid;
        else
            hi = mid - 1;
    }
    return lo;
}
#endif

#ifdef __cplusplus
static_assert(sizeof(EmissiveTriangle) == 64,
              "EmissiveTriangle must match the Slang scalar layout");
static_assert(sizeof(LightGeometry) == 40, "LightGeometry layout mismatch");
static_assert(sizeof(EmissiveLightProxy) == 16, "EmissiveLightProxy layout mismatch");
static_assert(sizeof(LightBound) == 24, "LightBound layout mismatch");
static_assert(sizeof(EmissiveRegion) == 16, "EmissiveRegion layout mismatch");
#endif

} // namespace merian
