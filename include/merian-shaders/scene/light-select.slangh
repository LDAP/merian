#pragma once

#ifdef __cplusplus
#include "merian-shaders/types.slang.h"
#include <cstdint>
#endif

namespace merian {

// How a light is chosen for a shading point. All three build their tables in a per-frame
// preprocess; the per-sample work is what differs.
enum LightSelection : uint32_t {
    // Proportional to emitted power. One binary search over the whole scene, blind to where the
    // shading point is.
    LightSelectionPower = 0,
    // The same distribution, drawn once per frame into a pool: a sample is one load.
    LightSelectionPool = 1,
    // Per-frame world-space grid: each cell holds the light sources that reach it, so the choice
    // follows the shading point.
    LightSelectionGrid = 2,
};

enum LightSlotWeighing : uint32_t {
    LightSlotWeighingCell = 0,
    LightSlotWeighingShadingPoint = 1,
};

enum LightDebugView : uint32_t {
    LightDebugDrawOutcome = 0,
    LightDebugCell = 1,
    LightDebugSlots = 2,
    LightDebugCoverage = 3,
};

// How a direction towards the environment is chosen.
enum EnvSelection : uint32_t {
    // Hierarchical warp over the importance pyramid, per sample.
    EnvSelectionWarp = 0,
    // Per-frame pool of texels drawn by that warp; the sample is one load plus a jitter.
    EnvSelectionPool = 1,
};

// Light sources a cell holds, one slot each.
static const uint32_t LIGHT_GRID_SLOTS = 16;
static const uint32_t LIGHT_GRID_MAX_NEW_LIGHTS = 256;
static const uint32_t LIGHT_GRID_POOL = 1024;
static const uint32_t LIGHT_SOURCE_CHUNK = 64;
static const uint32_t LIGHT_GRID_DISCOVERED = 4;
static const uint32_t LIGHT_GRID_MAX_DRAWS = 8;
static const uint32_t LIGHT_GRID_SLOT_BITS = 4;
static const uint32_t LIGHT_GRID_DISPATCH_ROW = 32768;
static const uint32_t LIGHT_DEBUG_DRAWS = 16;
static const uint32_t LIGHT_DEBUG_COVERAGE_RAYS = 32;

#ifdef __cplusplus
static_assert((1u << LIGHT_GRID_SLOT_BITS) == LIGHT_GRID_SLOTS);
static_assert(LIGHT_GRID_MAX_DRAWS * LIGHT_GRID_SLOT_BITS <= 32);
#else
static const float LIGHT_GRID_MIN_VISIBILITY = 0.05f;
static const float LIGHT_GRID_MIN_DRAW_VISIBILITY = 0.0001f;
static const float LIGHT_GRID_PRIOR_VISIBILITY = 0.1f;
static const float LIGHT_GRID_PRIOR_SAMPLES = 8.f;
#endif

#ifndef __cplusplus
uint light_bucket_base(const uint bucket) {
    return bucket * LIGHT_GRID_SLOTS;
}
#endif

// One cascade of the light grid. Every cascade holds dimension^3 cells and is snapped to the
// camera, and the cell size doubles from one cascade to the next, so the resolution follows the
// distance to the camera. Points beyond the last cascade fall back to the pool.
struct LightGridInfo {
    float3 origin;
    float inv_cell_size;
    uint32_t dimension;
    uint32_t cascade_count;
};

#ifdef __cplusplus
static_assert(sizeof(LightGridInfo) == 24, "LightGridInfo layout mismatch");
#endif

} // namespace merian
