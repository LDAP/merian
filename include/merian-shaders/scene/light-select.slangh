#pragma once

#ifdef __cplusplus
#include "merian-shaders/types.slang.h"
#include <cstdint>
#endif

namespace merian {

enum LightSlotWeighing : uint32_t {
    LightSlotWeighingCell = 0,
    LightSlotWeighingShadingPoint = 1,
};

enum LightDebugView : uint32_t {
    LightDebugDrawOutcome = 0,
    LightDebugCell = 1,
    LightDebugSlots = 2,
    LightDebugCoverage = 3,
};

// How a direction towards the environment is chosen.
enum EnvSelection : uint32_t {
    // A binary search over the importance prefix sum, per sample.
    EnvSelectionSearch = 0,
    // Per-frame pool of texels drawn by that search; the sample is one load plus a jitter.
    EnvSelectionPool = 1,
};

static const uint32_t LIGHT_GRID_SLOTS = 32;
static const uint32_t LIGHT_GRID_MAX_DRAWS = 6;
static const uint32_t LIGHT_GRID_SLOT_BITS = 5;
// samples, contribution sum, squared contribution sum
static const uint32_t LIGHT_GRID_FEEDBACK_STRIDE = 3;
static const uint32_t LIGHT_DISPATCH_ROW = 32768;
static const uint32_t LIGHT_GRID_SETUP_GROUP = 256;
static const uint32_t LIGHT_GRID_SETUP_ITEMS = 4;
// the bounds as seven ordered maxima, then the groups done
static const uint32_t LIGHT_GRID_SETUP_STATE = 8;
static const uint32_t LIGHT_UPDATE_GROUP = 32;
static const uint32_t LIGHT_DEBUG_DRAWS = 16;
static const uint32_t LIGHT_DEBUG_COVERAGE_RAYS = 32;

// tree keys: Morton codes of the triangle centroids, then of the environment's texels
static const uint32_t LIGHT_TREE_SIDE_BITS = 10;
static const uint32_t LIGHT_TREE_ENV_KEY = 1u << 30;
static const uint32_t LIGHT_TREE_NO_KEY = 0xFFFFFFFFu;
static const uint32_t LIGHT_SORT_RADIX_BITS = 8;
static const uint32_t LIGHT_SORT_PASSES = 4;
static const uint32_t LIGHT_SORT_GROUP = 256;
static const uint32_t LIGHT_SORT_TILE = 512;

#ifdef __cplusplus
static_assert((1u << LIGHT_GRID_SLOT_BITS) == LIGHT_GRID_SLOTS);
static_assert(LIGHT_GRID_MAX_DRAWS * LIGHT_GRID_SLOT_BITS <= 32);
static_assert(LIGHT_SORT_RADIX_BITS * LIGHT_SORT_PASSES >= 3 * LIGHT_TREE_SIDE_BITS);
static_assert(LIGHT_SORT_PASSES % 2 == 0, "the sort must end in the buffers it started from");
static_assert(LIGHT_SORT_GROUP == 1u << LIGHT_SORT_RADIX_BITS,
              "the sort scatters a digit per thread");
#else
static const float LIGHT_GRID_MIN_CONTRIBUTION = 0.0001f;
static const float LIGHT_GRID_PRIOR_CONTRIBUTION = 0.5f;
static const float LIGHT_GRID_PRIOR_ENV_CONTRIBUTION = 0.005f;
static const float LIGHT_GRID_PRIOR_SAMPLES = 2.f;
static const float LIGHT_GRID_CONTRIBUTION_MEMORY = 64.f;
static const float LIGHT_GRID_REFINE_MARGIN = 2.f;
static const float LIGHT_GRID_DEAD_SAMPLES = 16.f;
static const uint LIGHT_GRID_FRESH_SPLITS = 8;
static const float LIGHT_GRID_MAX_CONTRIBUTION = 64.f;
static const float LIGHT_GRID_CONTRIBUTION_SCALE = 256.f;
static const float LIGHT_GRID_CONTRIBUTION_SQUARE_SCALE = 4.f;
// samples per slot and frame whose fixed-point sums cannot wrap
static const uint LIGHT_GRID_FEEDBACK_SAMPLES =
    0xFFFFFFFFu / (uint(LIGHT_GRID_MAX_CONTRIBUTION *
                        max(LIGHT_GRID_CONTRIBUTION_SCALE,
                            LIGHT_GRID_MAX_CONTRIBUTION* LIGHT_GRID_CONTRIBUTION_SQUARE_SCALE)) +
                   1u);
#endif

#ifndef __cplusplus
uint light_bucket_base(const uint bucket) {
    return bucket * LIGHT_GRID_SLOTS;
}
#endif

// One cascade of the light grid. Every cascade holds dimension^3 cells and is snapped to the
// camera, and the cell size doubles from one cascade to the next, so the resolution follows the
// distance to the camera. Points beyond the last cascade fall back to the pool.
struct LightGridInfo {
    float3 origin;
    float inv_cell_size;
    uint32_t dimension;
    uint32_t cascade_count;
};

struct LightTreeInfo {
    float3 origin;
    float inv_cell_size;
};

#ifdef __cplusplus
static_assert(sizeof(LightGridInfo) == 24, "LightGridInfo layout mismatch");
static_assert(sizeof(LightTreeInfo) == 16, "LightTreeInfo layout mismatch");
#endif

} // namespace merian
