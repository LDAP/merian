// Include after layout.slangh.
#pragma once

uint2 path_debug_dim() {
    return uint2(params.dim_x, params.dim_y);
}

uint2 path_debug_out_dim() {
    return uint2(params.out_x, params.out_y);
}

// where a pixel of the displayed image lies, in record pixels
float2 path_debug_render_coord(const uint2 out_pixel) {
    return (float2(out_pixel) + 0.5f) * float2(path_debug_dim()) / float2(path_debug_out_dim());
}

uint2 path_debug_render_pixel(const uint2 out_pixel) {
    return min(uint2(path_debug_render_coord(out_pixel)), path_debug_dim() - 1);
}

float3 path_debug_selected_point() {
    return float3(params.sel_point_x, params.sel_point_y, params.sel_point_z);
}

// 0 while unknown
float3 path_debug_selected_normal() {
    return float3(params.sel_normal_x, params.sel_normal_y, params.sel_normal_z);
}

bool path_debug_has_pixel() {
    return params.sel_pixel_x != PATH_DEBUG_NO_PIXEL;
}

uint2 path_debug_selected_pixel() {
    if (!path_debug_has_pixel()) {
        return path_debug_dim() / 2;
    }
    return uint2(params.sel_pixel_x, params.sel_pixel_y);
}

bool path_debug_selects_point() {
    return params.sel_mode == PATH_DEBUG_SELECT_POINT &&
           params.sel_record_x != PATH_DEBUG_NO_PIXEL;
}

// the local map frame's normal: the selected surface's, the pixel's until it is read back
float3 path_debug_map_normal(const float3 pixel_normal) {
    const float3 n = path_debug_selected_normal();
    return any(n != 0.f) ? n : pixel_normal;
}

bool path_debug_maps_at_point() {
    return path_debug_selects_point();
}

// the maps bin the draws the BSDF's pdf() is evaluated for
bool path_debug_bsdf_comparable() {
    return path_debug_maps_at_point() && params.wi_mode == PATH_DEBUG_WI_CAMERA;
}

bool path_debug_selects_region() {
    return params.sel_mode >= PATH_DEBUG_SELECT_THROUGH &&
           (params.sel_target != PATH_DEBUG_TARGET_SPHERE || params.sel_region_radius > 0.f);
}

bool path_debug_in_selected_pixel(const PathRecordPath p) {
    return all(p.pixel == uint2(params.sel_record_x, params.sel_record_y));
}

bool path_debug_starts_at_point(const PathRecordPath p, const uint vertex_region) {
    if (params.sel_point_tolerance <= 0.f) {
        return true;
    }
    const float3 first = path_record_load_vertex(in_records, vertex_region, p.vertex_offset).pos;
    return distance(first, path_debug_selected_point()) <= params.sel_point_tolerance;
}

uint path_debug_filtered_base(const uint2 pixel, const bool with_filter) {
    const uint pixels = params.dim_x * params.dim_y;
    return PATH_DEBUG_FILTERED_UINTS *
           ((with_filter ? pixels : 0) + pixel.y * params.dim_x + pixel.x);
}

uint path_debug_moments_base(const uint2 pixel) {
    return PATH_DEBUG_MOMENT_UINTS * (pixel.y * params.dim_x + pixel.x);
}

struct PathDebugPixelMoments {
    float mean;
    float variance;
    float rel_error;
    float max;
    uint count;
    uint zeros;
}

PathDebugPixelMoments path_debug_pixel_moments(const uint2 pixel) {
    const uint base = path_debug_moments_base(pixel);
    PathDebugPixelMoments m;
    m.count = moments[base + PATH_DEBUG_MOMENT_COUNT];
    m.zeros = moments[base + PATH_DEBUG_MOMENT_ZEROS];
    m.max = asfloat(moments[base + PATH_DEBUG_MOMENT_MAX]);
    m.mean = m.count > 0 ? asfloat(moments[base + PATH_DEBUG_MOMENT_SUM]) / float(m.count) : 0.f;
    const float mean_square =
        m.count > 0 ? asfloat(moments[base + PATH_DEBUG_MOMENT_SQUARES]) / float(m.count) : 0.f;
    m.variance = m.count > 1 ? max(mean_square - m.mean * m.mean, 0.f) : 0.f;
    m.rel_error = (m.count > 1 && m.mean > 0.f) ? sqrt(m.variance / float(m.count)) / m.mean : 0.f;
    return m;
}

float path_debug_pixel_statistic(const PathDebugPixelMoments m, const uint statistic) {
    switch (statistic) {
    case PATH_DEBUG_PIXEL_STAT_SAMPLES:
        return float(m.count);
    case PATH_DEBUG_PIXEL_STAT_VARIANCE:
        return m.variance;
    case PATH_DEBUG_PIXEL_STAT_REL_VARIANCE:
        return m.mean > 0.f ? m.variance / (m.mean * m.mean) : 0.f;
    case PATH_DEBUG_PIXEL_STAT_REL_ERROR:
        return m.rel_error;
    case PATH_DEBUG_PIXEL_STAT_MAX_RATIO:
        return m.mean > 0.f ? m.max / m.mean : 0.f;
    case PATH_DEBUG_PIXEL_STAT_ZERO:
        return m.count > 0 ? float(m.zeros) / float(m.count) : 0.f;
    default:
        return m.mean;
    }
}

// the record pixel shown at a render pixel: its own, or whose voxel the camera sees once it moved
uint2 path_debug_source_pixel(const uint2 render_pixel) {
    if (params.image_voxels == 0) {
        return render_pixel;
    }
    const uint source = voxel_image[render_pixel];
    return source == 0 ? uint2(PATH_DEBUG_NO_PIXEL)
                       : uint2((source - 1) % params.dim_x, (source - 1) / params.dim_x);
}

uint path_debug_map_region(const uint region, const uint index) {
    return region * params.map_res * params.map_res + index;
}
uint path_debug_map_set_at(const uint set, const uint field, const uint index) {
    return path_debug_map_region(set * PATH_DEBUG_SET_REGIONS + field, index);
}
uint path_debug_map_count_at(const uint set, const uint index) {
    switch (set) {
    case PATH_DEBUG_SET_GUIDING:
        return path_debug_map_region(PATH_DEBUG_MAP_GUIDING_REGION, index);
    case PATH_DEBUG_SET_CHECK:
        return path_debug_map_region(PATH_DEBUG_MAP_CHECK_REGION, index);
    default:
        return path_debug_map_set_at(set, PATH_DEBUG_SET_REGION_COUNT, index);
    }
}
uint path_debug_map_pdf_at(const uint index) {
    return path_debug_map_region(PATH_DEBUG_MAP_PDF_REGION, index);
}
uint path_debug_map_check_at(const uint index) {
    return path_debug_map_region(PATH_DEBUG_MAP_CHECK_REGION, index);
}
uint path_debug_map_check_recip_at(const uint index) {
    return path_debug_map_region(PATH_DEBUG_MAP_CHECK_RECIP_REGION, index);
}
uint path_debug_map_check_recip2_at(const uint index) {
    return path_debug_map_region(PATH_DEBUG_MAP_CHECK_RECIP2_REGION, index);
}
uint path_debug_map_eval_at(const uint index) {
    return path_debug_map_region(PATH_DEBUG_MAP_EVAL_REGION, 3 * index);
}
uint path_debug_map_integrand_at(const uint index) {
    return path_debug_map_region(PATH_DEBUG_MAP_INTEGRAND_REGION, 3 * index);
}
uint path_debug_map_moment_at(const uint index) {
    return path_debug_map_region(PATH_DEBUG_MAP_MOMENT_REGION, index);
}
uint path_debug_map_sphere_at(const uint index) {
    return path_debug_map_region(PATH_DEBUG_MAP_SPHERE_REGION, index);
}
float3 path_debug_load_float3(RWStructuredBuffer<uint, ScalarDataLayout> buf, const uint at) {
    return float3(asfloat(buf[at + 0]), asfloat(buf[at + 1]), asfloat(buf[at + 2]));
}
void path_debug_store_float3(RWStructuredBuffer<uint, ScalarDataLayout> buf,
                             const uint at,
                             const float3 value) {
    for (uint c = 0; c < 3; c++) {
        buf[at + c] = asuint(value[c]);
    }
}
float3 path_debug_map_eval(const uint index) {
    return path_debug_load_float3(maps, path_debug_map_eval_at(index));
}
uint path_debug_map_bin(const uint2 cell) {
    return cell.y * params.map_res + cell.x;
}
uint2 path_debug_map_cell_of(const uint bin) {
    return uint2(bin % params.map_res, bin / params.map_res);
}
uint2 path_debug_map_cell(const float2 uv) {
    return min(uint2(uv * params.map_res), params.map_res - 1);
}
float3 path_debug_map_integrand(const uint index) {
    return path_debug_load_float3(maps, path_debug_map_integrand_at(index));
}

float3 path_debug_wi_local(const float3 camera_wi_local) {
    if (params.wi_mode == PATH_DEBUG_WI_CAMERA) {
        return camera_wi_local;
    }
    const float st = sin(params.wi_theta);
    return float3(st * cos(params.wi_phi), st * sin(params.wi_phi), cos(params.wi_theta));
}

// the key of the heat grid cell holding pos, never the 0 of an empty slot
uint path_debug_grid_key(const float3 pos) {
    const int3 cell = int3(floor(pos / params.heat_cell_size));
    return max(pcg(pcg(pcg(asuint(cell.x)) ^ asuint(cell.y)) ^ asuint(cell.z)), 1u);
}

uint path_debug_grid_find(const uint key, const bool insert) {
    // a tombstone does not end the sequence, the key may live past it
    uint slot = key % params.grid_slots;
    for (uint probe = 0; probe < PATH_DEBUG_GRID_PROBES; probe++) {
        const uint stored = grid[slot];
        if (stored == key) {
            return slot;
        }
        if (stored == 0) {
            break;
        }
        slot = (slot + 1) % params.grid_slots;
    }
    if (!insert) {
        return PATH_DEBUG_GRID_INVALID;
    }

    slot = key % params.grid_slots;
    for (uint probe = 0; probe < PATH_DEBUG_GRID_PROBES; probe++) {
        const uint stored = grid[slot];
        if (stored == key) {
            return slot;
        }
        if (stored == 0 || stored == PATH_DEBUG_GRID_TOMBSTONE) {
            uint orig;
            InterlockedCompareExchange(grid[slot], stored, key, orig);
            if (orig == stored || orig == key) {
                return slot;
            }
        }
        slot = (slot + 1) % params.grid_slots;
    }
    InterlockedAdd(state[PATH_DEBUG_STATE_GRID_DROPPED], 1);
    return PATH_DEBUG_GRID_INVALID;
}

float2 path_debug_grid_at(const float3 pos) {
    const uint slot = path_debug_grid_find(path_debug_grid_key(pos), false);
    return slot == PATH_DEBUG_GRID_INVALID
               ? float2(0.f)
               : float2(asfloat(grid[params.grid_slots + slot]),
                        asfloat(grid[2 * params.grid_slots + slot]));
}

float path_debug_heat_value(const float2 cell) {
    return path_debug_heat_averages(params.heat_mode) ? (cell.y > 0.f ? cell.x / cell.y : 0.f)
                                                      : cell.x;
}

uint path_debug_token(const uint index) {
    switch (index) {
    case 0:
        return params.expr_0;
    case 1:
        return params.expr_1;
    case 2:
        return params.expr_2;
    case 3:
        return params.expr_3;
    case 4:
        return params.expr_4;
    case 5:
        return params.expr_5;
    case 6:
        return params.expr_6;
    default:
        return params.expr_7;
    }
}

// the technique that drew the vertex's outgoing direction
uint path_debug_vertex_labels(const uint meta) {
    return 1u << ((meta >> PATH_RECORD_METHOD_SHIFT) & PATH_RECORD_METHOD_MASK);
}

bool path_debug_token_matches(const uint token, const uint meta, const uint labels) {
    const uint lobe = (meta >> PATH_RECORD_LOBE_SHIFT) & PATH_RECORD_LOBE_MASK;
    const uint smoothness =
        lobe & (PATH_DEBUG_CLS_DELTA | PATH_DEBUG_CLS_GLOSSY | PATH_DEBUG_CLS_DIFFUSE);
    const uint cls = smoothness != 0 ? smoothness : PATH_DEBUG_CLS_UNKNOWN;
    const uint side = (lobe & PATH_RECORD_LOBE_TRANSMISSION) != 0 ? PATH_DEBUG_SIDE_TRANSMIT
                                                                  : PATH_DEBUG_SIDE_REFLECT;
    return (cls & token & PATH_DEBUG_CLS_MASK) != 0 &&
           (side & (token >> PATH_DEBUG_SIDE_SHIFT) & PATH_DEBUG_SIDE_MASK) != 0 &&
           (labels & (token >> PATH_DEBUG_LABEL_SHIFT)) != 0;
}

uint path_debug_token_repeat_min(const uint token) {
    return (token >> PATH_DEBUG_MIN_SHIFT) & PATH_DEBUG_MIN_MASK;
}

uint path_debug_token_repeat_max(const uint token) {
    return (token >> PATH_DEBUG_MAX_SHIFT) & PATH_DEBUG_MAX_MASK;
}

bool path_debug_is_connection(const uint meta) {
    return (meta & PATH_RECORD_FLAG_NEE) != 0;
}

float path_debug_finite_or_zero(const float value) {
    return isfinite(value) ? value : 0.f;
}

float3 path_debug_finite_or_zero(const float3 value) {
    return select(isfinite(value), value, float3(0.f));
}

uint path_debug_count_vertices(PathRecordStream records,
                               const PathRecordPath p,
                               const uint vertex_region,
                               const uint flags) {
    uint count = 0;
    for (uint v = 0; v < p.vertex_count; v++) {
        const uint meta =
            path_record_load_vertex_meta(records, vertex_region, p.vertex_offset + v);
        count += (meta & flags) == 0 ? 1 : 0;
    }
    return count;
}

uint path_debug_chain_length(PathRecordStream records,
                             const PathRecordPath p,
                             const uint vertex_region) {
    return path_debug_count_vertices(records, p, vertex_region, PATH_RECORD_FLAG_NEE);
}

bool path_debug_is_empty_draw(const PathRecordVertex v) {
    return v.nee && !v.resampled && !(v.pdf > 0.f);
}

// the paths of the selected point's pixel that start at it, every path without a point
bool path_debug_point_matches(const PathRecordPath p, const uint vertex_region) {
    return !path_debug_selects_point() ||
           (path_debug_in_selected_pixel(p) && path_debug_starts_at_point(p, vertex_region));
}

bool path_debug_segment_in_sphere(const float3 a, const float3 b) {
    const float3 q = path_debug_selected_point();
    const float3 edge = b - a;
    const float len2 = dot(edge, edge);
    const float t = len2 > 0.f ? clamp(dot(q - a, edge) / len2, 0.f, 1.f) : 0.f;
    const float3 d = a + t * edge - q;
    return dot(d, d) <= params.sel_region_radius * params.sel_region_radius;
}

bool path_debug_on_target(const float3 pos, const uint2 surface) {
    switch (params.sel_target) {
    case PATH_DEBUG_TARGET_SPHERE:
        return path_debug_segment_in_sphere(pos, pos);
    case PATH_DEBUG_TARGET_TRIANGLE:
        return surface.x != PATH_RECORD_GEOMETRY_NONE &&
               all(surface == uint2(params.sel_geometry, params.sel_primitive));
    case PATH_DEBUG_TARGET_ENVIRONMENT:
        return surface.x == PATH_RECORD_GEOMETRY_ENVIRONMENT;
    default:
        return surface.x < params.sel_target_geometries &&
               ((target_geometries[surface.x >> 5] >> (surface.x & 31u)) & 1u) != 0;
    }
}

// Where an expression can be before the next scatter event: per token the repeat counts it is
// at, last the end of the expression.
struct PathDebugExpressionState {
    uint counts[PATH_DEBUG_MAX_TOKENS + 1];
}

uint path_debug_expression_tokens() {
    return params.expr_count & PATH_DEBUG_EXPR_COUNT_MASK;
}

void path_debug_expression_close(inout PathDebugExpressionState state) {
    for (uint t = 0; t < path_debug_expression_tokens(); t++) {
        if ((state.counts[t] >> path_debug_token_repeat_min(path_debug_token(t))) != 0) {
            state.counts[t + 1] |= 1u;
        }
    }
}

PathDebugExpressionState path_debug_expression_begin() {
    PathDebugExpressionState state;
    for (uint t = 0; t <= PATH_DEBUG_MAX_TOKENS; t++) {
        state.counts[t] = t == 0 ? 1u : 0u;
    }
    path_debug_expression_close(state);
    return state;
}

// one more repeat; an unbounded token counts no further than its minimum
uint path_debug_expression_repeat(const uint counts, const uint token) {
    const uint repeat_min = path_debug_token_repeat_min(token);
    const uint repeat_max = path_debug_token_repeat_max(token);
    if (repeat_max == PATH_DEBUG_REPEAT_INF) {
        const uint next = counts << 1;
        return (next & ((1u << repeat_min) - 1u)) |
               ((next >> repeat_min) != 0 ? 1u << repeat_min : 0u);
    }
    return (counts & ((1u << repeat_max) - 1u)) << 1;
}

void path_debug_expression_step(inout PathDebugExpressionState state,
                                const uint meta,
                                const uint labels) {
    const uint tokens = path_debug_expression_tokens();
    for (uint t = 0; t < tokens; t++) {
        const uint token = path_debug_token(t);
        state.counts[t] = path_debug_token_matches(token, meta, labels)
                              ? path_debug_expression_repeat(state.counts[t], token)
                              : 0u;
    }
    state.counts[tokens] = 0u;
    path_debug_expression_close(state);
}

bool path_debug_expression_through(const PathDebugExpressionState state) {
    return (state.counts[path_debug_expression_tokens()] & 1u) != 0;
}

// The light paths of a recorded path: every one, those the region holds and those of them the
// filter passes, the point left out. An NEE connection or a vertex that carries contribution ends
// one; its scatter events are the chain vertices before it, the last drawn towards the light by
// the connection or by its own technique.
struct PathDebugEvents {
    uint2 mask_filtered;
    uint2 mask;
    float3 contrib_filtered;
    float3 contrib;
    float3 contrib_all;
}

PathDebugEvents path_debug_match_events(const PathRecordPath p, const uint vertex_region) {
    const bool expression = (params.expr_count & PATH_DEBUG_EXPR_ACTIVE) != 0;
    const bool region = path_debug_selects_region();
    const bool sphere = params.sel_target == PATH_DEBUG_TARGET_SPHERE;
    const uint method_mask = params.sel_method_mask;
    // before and after the last chain vertex, which a connection replaces with its own draw
    PathDebugExpressionState before = path_debug_expression_begin();
    PathDebugExpressionState after = before;

    PathDebugEvents events = {uint2(0), uint2(0), float3(0), float3(0), float3(0)};
    uint chain = 0;
    uint last_meta = 0;
    bool any_method = false;
    bool every_method = true;
    bool starts_on = false;
    bool hits_on = false;
    float3 chain_pos = float3(0);
    const uint vertices = min(p.vertex_count, PATH_DEBUG_MAX_SEGMENTS);
    // the next vertex's words load while this one is matched
    uint next_meta = path_record_load_vertex_meta(in_records, vertex_region, p.vertex_offset);
    float3 next_contrib = path_record_load_vertex_float3(
        in_records, vertex_region, p.vertex_offset, PATH_RECORD_VERTEX_CONTRIB);
    for (uint v = 0; v < vertices; v++) {
        const uint index = p.vertex_offset + v;
        const uint meta = next_meta;
        const float3 contrib = next_contrib;
        if (v + 1 < vertices) {
            next_meta = path_record_load_vertex_meta(in_records, vertex_region, index + 1);
            next_contrib = path_record_load_vertex_float3(in_records, vertex_region, index + 1,
                                                          PATH_RECORD_VERTEX_CONTRIB);
        }
        const bool nee = path_debug_is_connection(meta);
        float3 pos = float3(0);
        uint2 surface = uint2(0);
        if (region) {
            pos = path_record_load_vertex_float3(in_records, vertex_region, index,
                                                 PATH_RECORD_VERTEX_POS);
            const uint at = vertex_region + index * PATH_RECORD_VERTEX_UINTS;
            surface = uint2(in_records[at + PATH_RECORD_VERTEX_SURFACE],
                            in_records[at + PATH_RECORD_VERTEX_SURFACE + 1]);
        }
        const bool drawn = (meta & PATH_RECORD_FLAG_RESAMPLED) != 0 ||
                           asfloat(in_records[vertex_region + index * PATH_RECORD_VERTEX_UINTS +
                                              PATH_RECORD_VERTEX_PDF]) > 0.f;
        // an NEE connection needs the vertex it branches off
        const bool ends = nee ? chain > 0 && drawn : any(contrib != 0.f);
        if (ends) {
            const uint last_labels = nee ? path_debug_vertex_labels(meta)
                                         : path_debug_vertex_labels(last_meta);
            const bool finite = all(isfinite(contrib));
            bool passes = (params.sel_finite != PATH_DEBUG_FINITE_ONLY || finite) &&
                          (params.sel_finite != PATH_DEBUG_FINITE_NONFINITE || !finite) &&
                          chain >= params.sel_scatters_min && chain <= params.sel_scatters_max;
            if (method_mask != 0) {
                const bool last_method = chain > 0 && (last_labels & method_mask) != 0;
                passes = passes && (params.sel_method_mode == PATH_DEBUG_METHOD_EVERY_VERTEX
                                        ? chain > 0 && every_method && last_method
                                        : any_method || last_method);
            }
            if (expression && passes) {
                PathDebugExpressionState through = after;
                if (nee) {
                    through = before;
                    path_debug_expression_step(through, last_meta, last_labels);
                }
                passes = path_debug_expression_through(through);
            }
            bool held = true;
            if (region) {
                const bool end_on = path_debug_on_target(pos, surface);
                switch (params.sel_mode) {
                case PATH_DEBUG_SELECT_FROM:
                    held = chain == 0 ? end_on : starts_on;
                    break;
                case PATH_DEBUG_SELECT_TO:
                    held = end_on;
                    break;
                default:
                    held = hits_on || end_on ||
                           (sphere && chain > 0 && path_debug_segment_in_sphere(chain_pos, pos));
                }
            }
            const uint2 bit = v < 32 ? uint2(1u << v, 0) : uint2(0, 1u << (v - 32));
            events.contrib_all += contrib;
            if (held) {
                events.mask |= bit;
                events.contrib += contrib;
            }
            if (held && passes) {
                events.mask_filtered |= bit;
                events.contrib_filtered += contrib;
            }
        }
        if (nee) {
            continue;
        }

        if (expression) {
            before = after;
            path_debug_expression_step(after, meta, path_debug_vertex_labels(meta));
        }
        if (chain > 0) {
            const bool in_mask = (path_debug_vertex_labels(last_meta) & method_mask) != 0;
            any_method = any_method || in_mask;
            every_method = every_method && in_mask;
        }
        if (region) {
            const bool on = path_debug_on_target(pos, surface) ||
                            (sphere && chain > 0 && path_debug_segment_in_sphere(chain_pos, pos));
            starts_on = starts_on || (chain == 0 && on);
            hits_on = hits_on || on;
        }
        chain_pos = pos;
        last_meta = meta;
        chain++;
    }
    return events;
}

bool path_debug_is_event_vertex(const uint2 mask, const uint v) {
    return v < PATH_DEBUG_MAX_SEGMENTS &&
           (((v < 32 ? mask.x >> v : mask.y >> (v - 32)) & 1u) != 0);
}

// the vertex of the deepest event, -1 without one
int path_debug_last_event(const uint2 mask) {
    return mask.y != 0 ? 32 + int(firstbithigh(mask.y))
                       : (mask.x != 0 ? int(firstbithigh(mask.x)) : -1);
}

bool path_debug_filters() {
    return (params.expr_count & PATH_DEBUG_EXPR_ACTIVE) != 0 ||
           params.sel_finite != PATH_DEBUG_FINITE_ANY || params.sel_scatters_min != 0 ||
           params.sel_scatters_max != PATH_DEBUG_NO_SCATTER_LIMIT || params.sel_method_mask != 0;
}

// nothing but a point narrows the selection: every path is held whole, light or not
bool path_debug_selection_open(const bool with_filter) {
    return !path_debug_selects_region() && !(with_filter && path_debug_filters());
}

// the chain up to the deepest event, and the NEE connections that are events
bool path_debug_event_drawn(const uint2 mask,
                            const uint v,
                            const bool nee,
                            const bool with_filter) {
    return nee ? path_debug_is_event_vertex(mask, v)
               : path_debug_selection_open(with_filter) || int(v) <= path_debug_last_event(mask);
}

uint path_debug_events_depth(PathRecordStream records,
                             const PathRecordPath p,
                             const uint vertex_region,
                             const uint2 mask) {
    uint chain = 0;
    for (int v = 0; v < path_debug_last_event(mask); v++) {
        const uint meta =
            path_record_load_vertex_meta(records, vertex_region, p.vertex_offset + uint(v));
        chain += path_debug_is_connection(meta) ? 0 : 1;
    }
    return chain;
}

uint2 path_debug_path_events(const uint path_index, const bool with_filter) {
    const uint base = path_index * PATH_DEBUG_EVENT_UINTS +
                      (with_filter ? PATH_DEBUG_EVENT_MASK_FILTERED : PATH_DEBUG_EVENT_MASK);
    return uint2(events[base], events[base + 1]);
}

PathRecordPath path_debug_load_selected_path(const uint path_index, const bool with_filter) {
    PathRecordPath p = path_record_load_path(in_records, path_index);
    p.luminance = asfloat(events[path_index * PATH_DEBUG_EVENT_UINTS +
                                 (with_filter ? PATH_DEBUG_EVENT_LUMINANCE_FILTERED
                                           : PATH_DEBUG_EVENT_LUMINANCE)]);
    return p;
}

uint2 path_debug_kept_events(const uint slot) {
    return uint2(kept[PATH_DEBUG_KEPT_EVENTS + 2 * slot],
                 kept[PATH_DEBUG_KEPT_EVENTS + 2 * slot + 1]);
}

bool path_debug_matched(const uint path_index) {
    return (matches[path_index >> 5] & (1u << (path_index & 31u))) != 0;
}

bool path_debug_narrows() {
    return path_debug_selects_region() || path_debug_filters();
}

bool path_debug_holds(const uint path_index, const bool with_filter) {
    return path_debug_matched(path_index) &&
           (any(path_debug_path_events(path_index, with_filter) != 0) ||
            path_debug_selection_open(with_filter));
}

bool path_debug_paths_filtered() {
    return params.paths_filtered != 0;
}

// 4294967040 is the largest float below 2^32
uint path_debug_share_threshold(const float share) {
    return share >= 1.f ? 0xFFFFFFFFu : uint(4294967040.f * max(share, 0.f));
}

// per path and frame, independent of the record order and of the recorder's keep decision
uint path_debug_path_hash(const PathRecordPath p) {
    return pcg(pcg(pcg(in_records[PATH_RECORD_HDR_FRAME]) ^ path_record_pack_pixel(p.pixel)) ^
               p.sample_idx);
}

bool path_debug_keeps_top() {
    return path_debug_rank_keeps_top(params.overlay_rank);
}

bool path_debug_slot_kept(const uint slot) {
    return kept[PATH_DEBUG_KEPT_KEYS + slot] != 0;
}

// orders the paths of the kept top-k, as a positive float's bits; 0 = never kept
uint path_debug_top_key(const PathRecordPath p) {
    const float luminance = p.luminance;
    if (params.overlay_rank != PATH_DEBUG_RANK_RESAMPLED) {
        if (!isfinite(luminance)) {
            return asuint(PATH_DEBUG_MAX_KEY);
        }
        // brightest share leaves the black paths out
        if (params.overlay_rank == PATH_DEBUG_RANK_BRIGHTEST_SHARE && !(luminance > 0.f)) {
            return 0;
        }
        return max(asuint(max(luminance, 0.f)), 1u);
    }
    if (!(luminance > 0.f) || !isfinite(luminance)) {
        return 0;
    }
    const float u = path_debug_unit_interval(path_debug_path_hash(p));
    const float keep_prob = asfloat(in_records[PATH_RECORD_HDR_KEEP_PROB]);
    const float key = path_debug_resample_key(luminance / max(keep_prob, 1e-30f), u);
    return max(asuint(min(key, PATH_DEBUG_MAX_KEY)), 1u);
}

uint path_debug_kept_key_now(const uint slot) {
    const uint key = kept[PATH_DEBUG_KEPT_KEYS + slot];
    if (key == 0) {
        return 0;
    }
    return max(asuint(asfloat(key) * params.overlay_key_decay), 1u);
}

void path_debug_keep_path(const uint slot,
                          const uint path_index,
                          const PathRecordPath p,
                          const uint key) {
    const uint vertex_region = path_record_vertex_region_offset(in_records);
    const uint vertices = min(p.vertex_count, PATH_DEBUG_MAX_SEGMENTS);
    const uint dst = PATH_RECORD_HEADER_UINTS + slot * PATH_RECORD_UINTS;
    kept[dst + PATH_RECORD_PATH_PIXEL] = path_record_pack_pixel(p.pixel);
    kept[dst + PATH_RECORD_PATH_VERTEX_OFFSET] = slot * PATH_DEBUG_MAX_SEGMENTS;
    kept[dst + PATH_RECORD_PATH_COUNT_SAMPLE] = vertices | (p.sample_idx << 16);
    kept[dst + PATH_RECORD_PATH_LUMINANCE] = asuint(p.luminance);
    const uint src_vertices = vertex_region + p.vertex_offset * PATH_RECORD_VERTEX_UINTS;
    const uint dst_vertices =
        PATH_DEBUG_KEPT_VERTICES + slot * PATH_DEBUG_MAX_SEGMENTS * PATH_RECORD_VERTEX_UINTS;
    for (uint w = 0; w < vertices * PATH_RECORD_VERTEX_UINTS; w++) {
        kept[dst_vertices + w] = in_records[src_vertices + w];
    }
    kept[PATH_DEBUG_KEPT_KEYS + slot] = key;
    const uint2 mask = path_debug_path_events(path_index, path_debug_paths_filtered());
    kept[PATH_DEBUG_KEPT_EVENTS + 2 * slot] = mask.x;
    kept[PATH_DEBUG_KEPT_EVENTS + 2 * slot + 1] = mask.y;
}

void path_debug_recent_commit(const uint path_index, const PathRecordPath p) {
    if (params.overlay_keep_update == 0) {
        return;
    }
    const uint matched = state[PATH_DEBUG_STATE_MATCHED];
    if (matched > params.overlay_max_paths &&
        path_debug_path_hash(p) >
            path_debug_share_threshold(float(params.overlay_max_paths) / float(matched))) {
        return;
    }
    uint order;
    InterlockedAdd(state[PATH_DEBUG_STATE_RECENT_COUNT], 1, order);
    if (order >= params.overlay_max_paths) {
        return;
    }
    path_debug_keep_path((kept[PATH_DEBUG_KEPT_HEAD] + order) % params.overlay_max_paths,
                         path_index, p, 1);
}

uint path_debug_recent_advance() {
    return min(state[PATH_DEBUG_STATE_RECENT_COUNT], params.overlay_max_paths);
}

uint path_debug_log_bin(const float value,
                        const float min_log,
                        const float max_log,
                        const uint bins) {
    if (!(value > 0.f)) {
        return 0;
    }
    const float normalized = (log2(value) - min_log) / (max_log - min_log);
    // clamped as int: a negative float converted to uint is undefined
    return uint(clamp(int(normalized * (bins - 2)) + 1, 1, int(bins - 1)));
}

uint path_debug_key_bin(const uint key) {
    return path_debug_log_bin(asfloat(key), PATH_DEBUG_KEY_MIN_LOG, PATH_DEBUG_KEY_MAX_LOG,
                              PATH_DEBUG_HIST_BINS);
}

#if defined(MERIAN_SPIRV_CAP_SUPPORTED_AtomicFloat32AddEXT)
void path_debug_atomic_add_float(RWStructuredBuffer<uint, ScalarDataLayout> buf,
                                 RWStructuredBuffer<float, ScalarDataLayout> buf_f,
                                 const uint index,
                                 const float value) {
    InterlockedAdd(buf_f[index], value);
}
#else
void path_debug_atomic_add_float(RWStructuredBuffer<uint, ScalarDataLayout> buf,
                                 RWStructuredBuffer<float, ScalarDataLayout> buf_f,
                                 const uint index,
                                 const float value) {
    uint expected = buf[index];
    for (;;) {
        uint orig;
        InterlockedCompareExchange(buf[index], expected, asuint(asfloat(expected) + value), orig);
        if (orig == expected) {
            break;
        }
        expected = orig;
    }
}
#endif

void path_debug_atomic_add_float3(RWStructuredBuffer<uint, ScalarDataLayout> buf,
                                  RWStructuredBuffer<float, ScalarDataLayout> buf_f,
                                  const uint index,
                                  const float3 value) {
    for (uint c = 0; c < 3; c++) {
        path_debug_atomic_add_float(buf, buf_f, index + c, value[c]);
    }
}

void path_debug_atomic_max_float(RWStructuredBuffer<uint, ScalarDataLayout> buf,
                                 const uint index,
                                 const float value) {
    InterlockedMax(buf[index], asuint(max(value, 0.f))); // positive floats order as uints
}

// three decades below vmax onto [0, 1]
float path_debug_log_decades(const float value, const float vmax, const float exposure) {
    return saturate(log(1.f + exposure * 999.f * value / vmax) / log(1000.f));
}
