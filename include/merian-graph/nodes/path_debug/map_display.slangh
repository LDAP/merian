// Include after common.slangh; needs merian_shaders.colors.colorspaces, colormaps and
// utils.dir_map.

#include "merian-graph/nodes/path_debug/map_test.slangh"

float3 path_debug_map_heat_color(const float value, const float vmax) {
    if (!(value > 0.f) || !(vmax > 0.f)) {
        return float3(0.04f);
    }
    return merian::colormap_turbo(path_debug_log_decades(value, vmax, params.map_exposure));
}

float3 path_debug_map_color(const uint view, const uint2 cell) {
    const uint bin = cell.y * params.map_res + cell.x;
    const float solid_angle = dir_map_bin_solid_angle(params.map_transform, cell, params.map_res);
    if (solid_angle <= 0.f) {
        return float3(0.02f);
    }
    const uint total = max(stats[PATH_DEBUG_STATS_SAMPLES], 1u);
    const uint count = maps[path_debug_map_count_at(bin)];
    const uint c = path_debug_map_contrib_at(bin);
    const float3 contrib = float3(asfloat(maps[c + 0]), asfloat(maps[c + 1]), asfloat(maps[c + 2]));
    const float pdf_raw = asfloat(maps[path_debug_map_pdf_at(bin)]);
    const float pdf = abs(pdf_raw);

    const float shared_max = max(max(max(asfloat(stats[PATH_DEBUG_STATS_MAX_DENSITY]),
                                         asfloat(stats[PATH_DEBUG_STATS_MAX_PDF])),
                                     asfloat(stats[PATH_DEBUG_STATS_MAX_CHECK])),
                                 asfloat(stats[PATH_DEBUG_STATS_MAX_EVAL]));

    switch (view) {
    case PATH_DEBUG_MAP_DENSITY:
        return path_debug_map_heat_color(float(count) / (float(total) * solid_angle), shared_max);
    case PATH_DEBUG_MAP_CONTRIB:
        return path_debug_map_heat_color(merian::yuv_luminance(contrib) /
                                             (float(total) * solid_angle),
                                         asfloat(stats[PATH_DEBUG_STATS_MAX_CONTRIB]));
    case PATH_DEBUG_MAP_CONTRIB_COLOR: {
        if (count == 0) {
            return float3(0.f);
        }
        const float3 mean = contrib * (params.map_exposure / float(count));
        return pow(mean / (1.f + mean), 1.f / 2.2f);
    }
    case PATH_DEBUG_MAP_MEAN:
        return path_debug_map_heat_color(count > 0 ? merian::yuv_luminance(contrib) / float(count)
                                                   : 0.f,
                                         asfloat(stats[PATH_DEBUG_STATS_MAX_MEAN]));
    case PATH_DEBUG_MAP_PDF:
        return path_debug_map_heat_color(pdf, shared_max);
    case PATH_DEBUG_MAP_CHECK: {
        const uint check_total = max(stats[PATH_DEBUG_STATS_CHECK_SAMPLES], 1u);
        return path_debug_map_heat_color(float(maps[path_debug_map_check_at(bin)]) /
                                             (float(check_total) * solid_angle),
                                         shared_max);
    }
    case PATH_DEBUG_MAP_EVAL: {
        const float eval_norm = asfloat(stats[PATH_DEBUG_STATS_EVAL_NORM]);
        return path_debug_map_heat_color(
            eval_norm > 0.f ? asfloat(maps[path_debug_map_eval_at(bin)]) / eval_norm : 0.f,
            shared_max);
    }
    case PATH_DEBUG_MAP_RATIO: {
        if (params.map_pdf_ref == PATH_DEBUG_PDF_REF_RECORDED) {
            if (!path_debug_shared_support(false)) {
                return float3(0.12f);
            }
            const float sum_recip = asfloat(maps[path_debug_map_recip_at(bin)]);
            const float expected = float(stats[PATH_DEBUG_STATS_DRAWS]) * solid_angle;
            if (!(sum_recip > 0.f) || !(expected > 0.f)) {
                return float3(0.02f);
            }
            if (!path_debug_support_interior(cell)) {
                return float3(0.12f);
            }
            const float stops = clamp(log2(sum_recip / expected), -2.f, 2.f);
            return merian::colormap_diverging(stops / 4.f + 0.5f);
        }
        if (!path_debug_shared_support(true) ||
            path_debug_maps_hold(PATH_DEBUG_SEEN_CONNECTION | PATH_DEBUG_SEEN_RESAMPLED)) {
            return float3(0.12f);
        }
        const float norm = max(asfloat(stats[PATH_DEBUG_STATS_PDF_NORM]), 1e-6f);
        const float density = float(count) / (float(total) * solid_angle);
        if (!(pdf > 0.f) || !(density > 0.f)) {
            return float3(0.02f);
        }
        const float stops = clamp(log2(density * norm / pdf), -2.f, 2.f);
        return merian::colormap_diverging(stops / 4.f + 0.5f);
    }
    case PATH_DEBUG_MAP_ZSCORE:
    default: {
        if (params.map_pdf_ref == PATH_DEBUG_PDF_REF_RECORDED) {
            if (!path_debug_shared_support(false)) {
                return float3(0.12f);
            }
            const float sum_recip = asfloat(maps[path_debug_map_recip_at(bin)]);
            const float expected = float(stats[PATH_DEBUG_STATS_DRAWS]) * solid_angle;
            const float variance = path_debug_residual_variance(
                bin, true, asfloat(maps[path_debug_map_recip2_at(bin)]), false);
            if (!(variance > 0.f) || !path_debug_support_interior(cell)) {
                return float3(0.12f);
            }
            const float z = (sum_recip - expected) / sqrt(variance);
            return merian::colormap_diverging(clamp(z, -4.f, 4.f) / 8.f + 0.5f);
        }
        if (!path_debug_shared_support(true) ||
            path_debug_maps_hold(PATH_DEBUG_SEEN_CONNECTION | PATH_DEBUG_SEEN_RESAMPLED)) {
            return float3(0.12f);
        }
        const float norm = max(asfloat(stats[PATH_DEBUG_STATS_PDF_NORM]), 1e-6f);
        const float expected = float(total) * pdf * solid_angle / norm;
        if (path_debug_is_spike(float(count), expected)) {
            return float3(0.45f, 0.25f, 0.05f);
        }
        if (pdf_raw < 0.f) {
            return float3(0.12f);
        }
        if (expected < 1e-3f) {
            return float3(0.02f);
        }
        const float variance = path_debug_residual_variance(bin, false, expected, false);
        if (!(variance > 0.f)) {
            return float3(0.12f);
        }
        const float z = (float(count) - expected) / sqrt(variance);
        return merian::colormap_diverging(clamp(z, -4.f, 4.f) / 8.f + 0.5f);
    }
    }
}

float3 path_debug_map_color_uv(const uint view, const float2 uv) {
    return path_debug_map_color(view, min(uint2(uv * params.map_res), params.map_res - 1));
}

float3 path_debug_map_color_dir(const uint view, const float3 map_dir) {
    const float3 uvw = dir_map_uv(params.map_transform, map_dir);
    if (uvw.z == 0.f) {
        return float3(0.05f);
    }
    return path_debug_map_color_uv(view, uvw.xy);
}
