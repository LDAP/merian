PATH_DEBUG_FUNC uint32_t path_debug_set_stat(const uint32_t set, const uint32_t field) {
    return PATH_DEBUG_STATS_SET + (set * PATH_DEBUG_SET_UINTS) + field;
}
static const uint32_t PATH_DEBUG_STATS_SET_END =
    PATH_DEBUG_STATS_SET + (PATH_DEBUG_TESTED_SETS * PATH_DEBUG_SET_UINTS);

