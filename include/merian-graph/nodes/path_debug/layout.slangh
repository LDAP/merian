RWTexture2D<float4> out_filtered;

RWStructuredBuffer<uint, ScalarDataLayout> state;
RWStructuredBuffer<uint, ScalarDataLayout> out_state;
RWStructuredBuffer<uint, ScalarDataLayout> stats;
RWStructuredBuffer<uint, ScalarDataLayout> maps;
RWStructuredBuffer<uint, ScalarDataLayout> grid;
RWStructuredBuffer<float, ScalarDataLayout> stats_f;
RWStructuredBuffer<float, ScalarDataLayout> maps_f;
RWStructuredBuffer<float, ScalarDataLayout> grid_f;
RWStructuredBuffer<uint, ScalarDataLayout> moments;
RWStructuredBuffer<float, ScalarDataLayout> moments_f;
// the record pixel + 1 whose voxel the camera sees, 0 for none
RWTexture2D<uint> voxel_image;
RWStructuredBuffer<uint, ScalarDataLayout> filtered;
RWStructuredBuffer<float, ScalarDataLayout> filtered_f;
// per record pixel the first-hit distance and |dz/dx| + |dz/dy|
RWStructuredBuffer<float2, ScalarDataLayout> voxel_depth;
RWStructuredBuffer<uint, ScalarDataLayout> matches;
RWStructuredBuffer<uint, ScalarDataLayout> events;
RWStructuredBuffer<uint, ScalarDataLayout> target_geometries;
