PATH_DEBUG_FUNC bool path_debug_heat_averages(const uint32_t mode) {
    return mode == PATH_DEBUG_HEAT_THROUGHPUT || mode == PATH_DEBUG_HEAT_INCIDENT ||
           mode == PATH_DEBUG_HEAT_SAMPLE_WEIGHT;
}

static const uint32_t PATH_DEBUG_GRID_PROBES = 8;
static const uint32_t PATH_DEBUG_GRID_INVALID = 0xFFFFFFFFu;
static const uint32_t PATH_DEBUG_GRID_TOMBSTONE = 0xFFFFFFFFu;
// heat grid: [0, slots) cell keys (0 = empty), [slots, 2 * slots) weights, then the vertices
// splatted, both decaying
static const uint32_t PATH_DEBUG_GRID_REGIONS = 3;

static const uint32_t PATH_DEBUG_DEPTH_XRAY = 0;
static const uint32_t PATH_DEBUG_DEPTH_HIDE = 1;
static const uint32_t PATH_DEBUG_DEPTH_DASH = 2;

static const uint32_t PATH_DEBUG_COLOR_LUMINANCE = 0;
static const uint32_t PATH_DEBUG_COLOR_CONTRIBUTION = 1;
static const uint32_t PATH_DEBUG_COLOR_SCATTER_EVENTS = 2;
static const uint32_t PATH_DEBUG_COLOR_RANDOM = 3;
static const uint32_t PATH_DEBUG_COLOR_TECHNIQUE = 4;
static const uint32_t PATH_DEBUG_COLOR_SAMPLE_WEIGHT = 5;
static const uint32_t PATH_DEBUG_COLOR_TRANSPORTED = 6;
static const uint32_t PATH_DEBUG_COLOR_OFF = 7;
static const float PATH_DEBUG_LUMINANCE_STOPS = 16.f;
static const float PATH_DEBUG_CONTRIBUTION_STOPS = 10.f;
static const float PATH_DEBUG_SAMPLE_WEIGHT_STOPS = 8.f;

static const uint32_t PATH_DEBUG_METHOD_COLORS[PATH_RECORD_METHOD_COUNT] = {
    0x9a9a9a, 0x9a9a9a, 0x9a9a9a, 0x5ec8f0, 0xc080ff, 0xffd83c, 0x2e6be6, 0xff9a3c, 0xff3c3c};
static const uint32_t PATH_DEBUG_START_COLOR = 0x33ff33;
static const uint32_t PATH_DEBUG_END_COLOR = 0xff4040;
static const uint32_t PATH_DEBUG_ESCAPED_COLOR = 0x4d99ff;
static const uint32_t PATH_DEBUG_SCATTER_COLOR_EVENTS = 16;

PATH_DEBUG_FUNC float3 path_debug_unpack_rgb(const uint32_t rgb) {
    return float3(float((rgb >> 16) & 0xFFu), float((rgb >> 8) & 0xFFu), float(rgb & 0xFFu)) /
           255.f;
}

static const uint32_t PATH_DEBUG_BACKDROP_SOURCE = 0;
static const uint32_t PATH_DEBUG_BACKDROP_FRAME = 1;
static const uint32_t PATH_DEBUG_BACKDROP_FRAME_FILTERED = 2;
static const uint32_t PATH_DEBUG_BACKDROP_ACCUMULATED = 3;
static const uint32_t PATH_DEBUG_BACKDROP_ACCUMULATED_FILTERED = 4;
static const uint32_t PATH_DEBUG_BACKDROP_REFERENCE = 5;
static const uint32_t PATH_DEBUG_BACKDROP_DIFFERENCE = 6;
static const uint32_t PATH_DEBUG_BACKDROP_SPLIT_REFERENCE = 7;
static const uint32_t PATH_DEBUG_BACKDROP_INPUT = 8;

PATH_DEBUG_FUNC bool path_debug_backdrop_recorded(const uint32_t backdrop) {
    return backdrop >= PATH_DEBUG_BACKDROP_FRAME &&
           backdrop <= PATH_DEBUG_BACKDROP_ACCUMULATED_FILTERED;
}
PATH_DEBUG_FUNC bool path_debug_backdrop_filtered(const uint32_t backdrop) {
    return backdrop == PATH_DEBUG_BACKDROP_FRAME_FILTERED ||
           backdrop == PATH_DEBUG_BACKDROP_ACCUMULATED_FILTERED;
}
PATH_DEBUG_FUNC bool path_debug_backdrop_accumulated(const uint32_t backdrop) {
    return backdrop == PATH_DEBUG_BACKDROP_ACCUMULATED ||
           backdrop == PATH_DEBUG_BACKDROP_ACCUMULATED_FILTERED;
}

static const uint32_t PATH_DEBUG_PIXEL_STAT_OFF = 0;
static const uint32_t PATH_DEBUG_PIXEL_STAT_MEAN = 1;
static const uint32_t PATH_DEBUG_PIXEL_STAT_SAMPLES = 2;
static const uint32_t PATH_DEBUG_PIXEL_STAT_VARIANCE = 3;
static const uint32_t PATH_DEBUG_PIXEL_STAT_REL_VARIANCE = 4;
static const uint32_t PATH_DEBUG_PIXEL_STAT_REL_ERROR = 5;
static const uint32_t PATH_DEBUG_PIXEL_STAT_MAX_RATIO = 6;
static const uint32_t PATH_DEBUG_PIXEL_STAT_ZERO = 7;

// scalars only: a vector would pad to its alignment and the two sides would drift apart
struct PathDebugParams {
    // the pixels the records are traced in
    uint32_t dim_x;
    uint32_t dim_y;
    // the displayed image
    uint32_t out_x;
    uint32_t out_y;

    // the selection's pixel in the current view, then in the view the records were traced from
    uint32_t sel_pixel_x;
    uint32_t sel_pixel_y;
    uint32_t sel_record_x;
    uint32_t sel_record_y;
    float sel_point_x;
    float sel_point_y;
    float sel_point_z;
    float sel_normal_x;
    float sel_normal_y;
    float sel_normal_z;
    float sel_region_radius;
    uint32_t sel_point_valid;
    // a point's path must start this close to it, else its pixel sees another surface; 0 = any
    float sel_point_tolerance;
    uint32_t sel_mode;
    uint32_t sel_target;
    uint32_t sel_geometry;
    uint32_t sel_primitive;
    uint32_t sel_target_geometries;
    uint32_t sel_scatters_min;
    uint32_t sel_scatters_max;
    uint32_t sel_method_mask;
    uint32_t sel_method_mode;
    uint32_t sel_finite;
    uint32_t paths_filtered;
    uint32_t false_color_filtered;
    uint32_t expr_0;
    uint32_t expr_1;
    uint32_t expr_2;
    uint32_t expr_3;
    uint32_t expr_4;
    uint32_t expr_5;
    uint32_t expr_6;
    uint32_t expr_7;
    uint32_t expr_count;

    uint32_t overlay_rank;
    uint32_t overlay_max_paths;
    float overlay_key_decay;
    float overlay_brightest_share;
    float overlay_alpha;
    uint32_t overlay_depth_mode;
    float overlay_thickness;
    uint32_t overlay_color;
    float overlay_color_scale;
    uint32_t overlay_isolate;
    uint32_t overlay_keep_update;

    uint32_t backdrop;
    float backdrop_split;
    float difference_gain;
    float image_exposure;

    uint32_t map_res;
    uint32_t map_transform;
    uint32_t map_frame;
    uint32_t map_batch_end;
    uint32_t map_panel_mask;
    uint32_t want_top_list;
    float map_exposure;
    uint32_t stats_stride;
    uint32_t sphere_channel;
    float sphere_radius;
    uint32_t sphere_scale;
    uint32_t wi_mode;
    float wi_theta;
    float wi_phi;
    uint32_t map_fold_only;
    // the BSDF kernels capture the selected pixel's camera ray, hit and normal, else reuse them
    uint32_t surface_capture;

    uint32_t heat_mode;
    uint32_t heat_bounce_min;
    uint32_t heat_bounce_max;
    float heat_decay;
    float heat_cell_size;
    float heat_exposure;
    float false_color_opacity;
    uint32_t heat_smooth;
    uint32_t grid_slots;

    uint32_t pixel_stats_accumulate;
    uint32_t filtered_active;
    uint32_t filtered_out;
    uint32_t image_accumulate;
    uint32_t image_depth;
    uint32_t image_voxels;
    uint32_t pixel_stats_view;
    float pixel_stats_scale;

    uint32_t freeze;
    uint32_t capture_off;
    float keep_prob;
    uint32_t record_pixel;
    // a point's pixel the whole-image recording keeps every path of
    uint32_t record_keep_pixel;

    uint32_t cursor_x;
    uint32_t cursor_y;
    uint32_t probe_channel;
    uint32_t probe_bin;
    uint32_t pick_x;
    uint32_t pick_y;
    uint32_t pick_seq;
};

struct PathDebugCheckPass {
    uint32_t seq;
    // threads that draw PATH_DEBUG_CHECK_SAMPLES_PER_CELL samples each
    uint32_t sample_threads;
    uint32_t quadrature;
};

// where the displayed image lies in the overlay's render target, in its pixels; line widths are
// given at a display scale of 1
struct PathDebugOverlayView {
    float x;
    float y;
    float w;
    float h;
    float scale;
};

PATH_DEBUG_FUNC uint32_t path_debug_drawn_paths(const uint32_t max_paths, const uint32_t color) {
    return color == PATH_DEBUG_COLOR_OFF ? 0 : max_paths;
}

// line and vertex quads per path segment, then the region's ring and the point's marker
PATH_DEBUG_FUNC uint32_t path_debug_overlay_instances(const uint32_t max_paths) {
    return (2 * max_paths * PATH_DEBUG_MAX_SEGMENTS) + PATH_DEBUG_RING_SEGMENTS + 1;
}

PATH_DEBUG_FUNC uint32_t path_debug_pack_sample_count(const uint32_t sample, const uint32_t count) {
    return (sample & 0xFFFFu) | (count << 16);
}

PATH_DEBUG_FUNC uint32_t path_debug_unpack_sample(const uint32_t word) {
    return word & 0xFFFFu;
}

PATH_DEBUG_FUNC uint32_t path_debug_unpack_count(const uint32_t word) {
    return word >> 16;
}

// strictly inside (0, 1)
PATH_DEBUG_FUNC float path_debug_unit_interval(const uint32_t hash) {
    return (float(hash >> 9) + 0.5f) / 8388608.f;
}

// A-ES (Efraimidis and Spirakis 2006); w / -ln(u) orders as u^(1/w)
PATH_DEBUG_FUNC float path_debug_resample_key(const float weight, const float u) {
    // the GPU's log may round -ln(u) to 0 or below near u = 1; 2^-24 is -ln of the largest u
    const float min_neg_log = 5.96046448e-8f;
    const float neg_log = -log(u);
    return weight / (neg_log > min_neg_log ? neg_log : min_neg_log);
}

// per pixel over every recorded path: what it adds, or what the region and the filter add, its
// square, the paths, the brightest one (positive float bits) and the ones that add nothing
static const uint32_t PATH_DEBUG_MOMENT_SUM = 0;
static const uint32_t PATH_DEBUG_MOMENT_SQUARES = 1;
static const uint32_t PATH_DEBUG_MOMENT_COUNT = 2;
static const uint32_t PATH_DEBUG_MOMENT_MAX = 3;
static const uint32_t PATH_DEBUG_MOMENT_ZEROS = 4;
static const uint32_t PATH_DEBUG_MOMENT_UINTS = 5;
// per pixel the rgb and count of every recorded path, then the same of the region and the filter
static const uint32_t PATH_DEBUG_FILTERED_UINTS = 4;
static const uint32_t PATH_DEBUG_FILTERED_COUNT = 3;

} // namespace merian

