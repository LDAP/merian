#pragma once

// The path of a reservoir as the shift into the pixel it is shaded in traces it, for the path
// record stream. Resampling selected the path as a whole, so no vertex has a density of its own:
// the first carries 1/W of the path, the light vertex what the pixel shades with it.

#include "merian-graph/nodes/render_restir_pt/restir_pt_shift.slangh"

namespace merian {

struct RestirPTPathRecord : IRestirPTPathSink {
    PathRecordStream stream;
    PathRecorder rec;
    float pdf;
    float3 contribution;
    float3 last_pos;
    bool open;
    bool reconnected;

    bool records() {
        return true;
    }

    [mutating]
    void vertex(const float3 pos,
                const float3 wo,
                const uint bounce,
                const uint lobe,
                const uint method,
                const uint material) {
        if (!open)
            return;
        rec.vertex(stream, pos, wo, pdf, float3(0), bounce, lobe, method,
                   path_record_pack_material(material), PATH_RECORD_FLAG_RESAMPLED);
        pdf = 0.f;
        last_pos = pos;
        reconnected |= method == PATH_RECORD_METHOD_RECONNECTION;
    }

    [mutating]
    void connection(const float3 from,
                    const float3 light_pos,
                    const uint bounce,
                    const uint method,
                    const uint material) {
        if (!open)
            return;
        rec.terminal(stream, from);
        rec.connection(stream, from, light_pos, pdf, float3(0), contribution, bounce, method,
                       path_record_pack_material(material), PATH_RECORD_FLAG_RESAMPLED);
        rec.finish(stream);
        open = false;
    }

    [mutating]
    void light(const float3 pos) {
        if (!open)
            return;
        rec.emission(contribution);
        rec.end(stream, pos);
        open = false;
    }

    // ends a path the shift left before its light vertex
    [mutating]
    void close() {
        if (open)
            rec.end(stream, last_pos);
        open = false;
    }
}

void restir_pt_record_shaded(const ParameterBlock<Scene> scene,
                             const RestirPTPrimary primary,
                             const RestirPTReservoir r,
                             const PathRecordStream records,
                             inout PathRecorder rec,
                             inout RandomGenerator rng) {
    const ShadingPoint sp = scene.get_shading_point(primary.ray, primary.hit);
    if (merian_restir_pt_emission_on_primary && !merian_restir_pt_area)
        rec.emission(sp.emission);

    RestirPTPathRecord path;
    path.stream = records;
    path.rec = rec;
    path.pdf = 1.f / r.W;
    path.contribution = r.integrand * r.W;
    path.last_pos = sp.pos;
    path.open = true;
    path.reconnected = false;
    if (r.W > 0.f && all(isfinite(path.contribution))) {
        restir_pt_shift(scene, primary, r, false, rng, path);
        if (path.reconnected)
            restir_pt_update_suffix(scene, r, false, rng, path);
    }
    path.close();
    rec = path.rec;
}

} // namespace merian
