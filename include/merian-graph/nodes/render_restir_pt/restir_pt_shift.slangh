#pragma once

// The shift map: replay the random numbers of the prefix in the destination, then reconnect to
// x_k and keep everything from there on [Lin et al. 2022, 7.3; Lin et al. 2026, 4].
//
// The integrand is measured in solid angle around x_k, so the Jacobian of the reconnection is the
// ratio of the geometry terms into x_k, and the replayed prefix contributes none.

#include "merian-graph/nodes/render_restir_pt/restir_pt_path.slangh"

namespace merian {

// Receives the segments a shift traces, in path order.
interface IRestirPTPathSink {
    bool records();
    [mutating]
    void vertex(const float3 pos,
                const float3 wo,
                const uint bounce,
                const uint lobe,
                const uint method,
                const uint material,
                const uint2 surface);
    // the path ends with a light sample drawn at `from`
    [mutating]
    void connection(const float3 from,
                    const float3 light_pos,
                    const uint bounce,
                    const uint method,
                    const uint material,
                    const uint2 from_surface,
                    const uint2 light_surface);
    // the path ends on an emitter
    [mutating]
    void light(const float3 pos, const uint2 surface);
}

struct RestirPTNoSink : IRestirPTPathSink {
    bool records() {
        return false;
    }
    [mutating]
    void vertex(const float3 pos,
                const float3 wo,
                const uint bounce,
                const uint lobe,
                const uint method,
                const uint material,
                const uint2 surface) {}
    [mutating]
    void connection(const float3 from,
                    const float3 light_pos,
                    const uint bounce,
                    const uint method,
                    const uint material,
                    const uint2 from_surface,
                    const uint2 light_surface) {}
    [mutating]
    void light(const float3 pos, const uint2 surface) {}
}

float3 restir_pt_kept_light_pos(const ParameterBlock<Scene> scene,
                                const RestirPTReservoir r,
                                const float3 from,
                                const bool prev_frame) {
    if ((r.flags & RESTIR_PT_LIGHT_ENV) != 0)
        return from + octahedral_unproject(r.light_coords) * ENV_MAP_DISTANCE;
    TriangleHit tri;
    Surface surface;
    if (!restir_pt_hit_surface(scene, restir_pt_get_light(r), prev_frame, tri, surface))
        return from;
    return surface.pos;
}

RestirPTShift restir_pt_failed_shift() {
    RestirPTShift s;
    s.integrand = float3(0);
    s.jacobian = 0.f;
    return s;
}

// `from_inverse_geometry` < 0: x'_{k-1} cannot reconnect because of the segment into it
RestirPTShift restir_pt_reconnect<P : IRestirPTPathSink>(const ParameterBlock<Scene> scene,
                                                         const float primary_footprint,
                                                         const ShadingPoint sp,
                                                         const Hit sp_hit,
                                                         const float3 wi,
                                                         const float3 throughput,
                                                         const float from_inverse_geometry,
                                                         const RestirPTReservoir r,
                                                         const bool prev_frame,
                                                         inout RandomGenerator rng,
                                                         inout P path) {
    const RestirPTShift failed = restir_pt_failed_shift();

    const uint n = restir_pt_light_vertex(r.flags);
    const uint k = restir_pt_rc_vertex(r.flags);
    const bool nee = (r.flags & RESTIR_PT_LIGHT_NEE) != 0;
    const bool light_rc = k == n;
    const bool distant = light_rc && (r.flags & RESTIR_PT_LIGHT_ENV) != 0;
    const RestirPTLobe prev_lobe = restir_pt_lobe(r.flags, RESTIR_PT_LOBE_PREV_SHIFT);
    const RestirPTLobe rc_lobe = restir_pt_lobe(r.flags, RESTIR_PT_LOBE_RC_SHIFT);
    // a delta lobe on either side of x_k has no density to reconnect with
    const bool delta = !sp.has_surface_material || prev_lobe == RestirPTLobeDelta ||
                       (!light_rc && rc_lobe == RestirPTLobeDelta);
    if (delta && !path.records())
        return failed;

    // 1. where x_k is seen from x'_{k-1}
    const Hit hit = restir_pt_get_hit(r);
    const float3 ng = sp.get_face_normal();
    float3 origin = sp.pos;
    float3 dir = r.rc_wo;
    float dist2 = 1.f;
    TriangleHit tri;
    Surface surface;
    if (!distant) {
        if (!restir_pt_hit_surface(scene, hit, prev_frame, tri, surface))
            return failed;
        origin = offset_ray_origin(sp.pos, ng, sp.spawn_offset, surface.pos - sp.pos);
        const float3 d = surface.pos - origin;
        dist2 = dot(d, d);
        dir = d * rsqrt(dist2);
    }
    const float geometry = distant ? 1.f : abs(dot(surface.face_normal, dir)) / dist2;
    const bool transmission = restir_pt_transmission(r.flags, RESTIR_PT_LOBE_PREV_SHIFT);
    const float3 rc_pos = distant ? sp.pos + dir * ENV_MAP_DISTANCE : surface.pos;
    const uint2 rc_surface =
        distant ? PATH_RECORD_SURFACE_ENVIRONMENT : path_record_surface(hit, false);
    if (light_rc && nee) {
        path.connection(sp.pos, rc_pos, k - 2, PATH_RECORD_METHOD_RECONNECTION, sp.material_id,
                        path_record_surface(sp_hit, scene.is_distant(sp_hit)), rc_surface);
    } else {
        path.vertex(sp.pos, dir, k - 2, restir_pt_record_lobe(prev_lobe, transmission),
                    PATH_RECORD_METHOD_RECONNECTION, sp.material_id,
                    path_record_surface(sp_hit, scene.is_distant(sp_hit)));
        if (light_rc)
            path.light(rc_pos, rc_surface);
    }
    if (delta)
        return failed;

    // 2. the segment leaves x'_{k-1} on the source's side
    const OrthonormalFrame frame = sp.shading_frame;
    const float3 wi_local = frame.to_local(wi);
    const float3 dir_local = frame.to_local(dir);
    if ((wi_local.z * dir_local.z < 0.f) != transmission ||
        !sp.geometric_side_agrees(wi, dir, transmission))
        return failed;
    let bsdf = sp.surface_material.get_bsdf();
    float p_prev;
    const float3 f_prev = bsdf.eval_pdf(wi_local, dir_local, rng, p_prev);
    if (!any(f_prev > 0.f) || !(geometry > 0.f))
        return failed;

    // 3. x_k must be where the destination reconnects too [Lin et al. 2026, 4]
    const bool hybrid = merian_restir_pt_shift_mapping == RestirPTShiftHybrid;
    const RestirPTThresholds thresholds = RestirPTThresholds(r.seed);
    const float limit = primary_footprint * thresholds.distance;
    const float inverse_geometry = dist2 / max(abs(dot(ng, dir)), 1e-6f);
    // a sampled light has no choice about where it reconnects
    const bool forced = light_rc && nee;
    if (hybrid) {
        if (from_inverse_geometry > 0.f && from_inverse_geometry / p_prev >= limit)
            return failed;
        if (!forced && (!restir_pt_is_rough(bsdf, thresholds.roughness) ||
                        (!distant && 1.f / (p_prev * geometry) < limit)))
            return failed;
    }

    RayDesc ray;
    ray.Origin = sp.pos;
    ray.Direction = dir;
    ray.TMin = 0.f;
    ray.TMax = SCENE_RAY_TMAX;

    float3 integrand = throughput * f_prev;
    if (light_rc) {
        // 4a. x_k is the light vertex: its density under the light techniques depends on where
        // it is seen from
        if (hybrid && !forced && !distant && inverse_geometry * MERIAN_TWO_PI < limit)
            return failed;
        float3 Le = r.rc_radiance;
        uint index = LIGHT_ENV_INDEX;
        if (!distant) {
            Le = scene
                     .get_shading_point(ray, hit, tri, surface, RenderContext(uint16_t(k - 1)),
                                        DefaultLODSampler(), false, prev_frame)
                     .emission;
            index = scene.get_light_index(hit, prev_frame);
        }
        const bool samples_lights = restir_pt_samples_lights(scene, bsdf, prev_frame);
        RandomGenerator light_rng = RestirPTRandom(r.seed).light(k - 1);
        float p_light = 0.f;
        if (samples_lights) {
            const DirectLightVertex vertex = restir_pt_begin_light_vertex(
                scene, prev_frame, sp.pos, ng, sp.spawn_offset, light_rng);
            // a drawn light point lies where the light techniques draw, a scattered one may not
            p_light = nee ? restir_pt_light_point_pdf(scene, prev_frame, vertex, index, surface.pos,
                                                      distant ? -dir : surface.face_normal)
                          : restir_pt_light_hit_pdf(scene, prev_frame, vertex, index,
                                                    hit.barycentrics, origin, dir);
        }
        integrand *= Le * (nee ? p_light : p_prev) / (p_light + p_prev);
    } else {
        // 4b. x_k scatters: re-shade it from the new direction
        const Hit light = restir_pt_get_light(r);
        TriangleHit light_tri;
        Surface light_surface;
        if (nee && light.is_valid() &&
            !restir_pt_hit_surface(scene, light, prev_frame, light_tri, light_surface))
            return failed;
        const ShadingPoint rc_sp =
            scene.get_shading_point(ray, hit, tri, surface, RenderContext(uint16_t(k - 1)),
                                    DefaultLODSampler(), true, prev_frame);
        if (!rc_sp.has_surface_material)
            return failed;
        const bool transmission_rc = restir_pt_transmission(r.flags, RESTIR_PT_LOBE_RC_SHIFT);
        const OrthonormalFrame frame_rc = rc_sp.shading_frame;
        const float3 wi_rc = frame_rc.to_local(-dir);
        const float3 wo_rc = frame_rc.to_local(r.rc_wo);
        if ((wi_rc.z * wo_rc.z < 0.f) != transmission_rc ||
            !rc_sp.geometric_side_agrees(-dir, r.rc_wo, transmission_rc))
            return failed;
        let bsdf_rc = rc_sp.surface_material.get_bsdf();
        float p_rc;
        const float3 f_rc = bsdf_rc.eval_pdf(wi_rc, wo_rc, rng, p_rc);
        if (!any(f_rc > 0.f))
            return failed;
        if (hybrid && inverse_geometry / p_rc < limit)
            return failed;
        integrand *= f_rc * r.rc_radiance;
        // the light vertex follows x_k: its technique is weighed against the new incident direction
        if (k + 1 == n)
            integrand *= (nee ? r.light_pdf : p_rc) / (r.light_pdf + p_rc);
    }

    // 5. visibility, towards the point offset to the side facing x'_{k-1}
    const float3 target =
        distant ? sp.pos + dir * ENV_MAP_DISTANCE
                : offset_ray_origin(surface.pos, surface.face_normal, surface.spawn_offset, -dir);
    if (!scene.trace_light_visibility(sp.pos, ng, sp.spawn_offset, target, distant,
                                      merian_restir_pt_instance_mask, prev_frame))
        return failed;

    RestirPTShift s;
    s.integrand = integrand;
    s.jacobian = distant ? 1.f : geometry * surface.area / r.rc_geometry;
    if (!all(isfinite(s.integrand)) || !isfinite(s.jacobian) || !(s.jacobian > 0.f) ||
        any(s.integrand < 0.f))
        return failed;
    return s;
}

// Re-traces the path after x_k in the frame it is evaluated in [Lin et al. 2026, 6].
RestirPTReservoir restir_pt_update_suffix<P : IRestirPTPathSink>(const ParameterBlock<Scene> scene,
                                                                 const RestirPTReservoir r,
                                                                 const bool prev_frame,
                                                                 inout RandomGenerator rng,
                                                                 inout P path) {
    const uint n = restir_pt_light_vertex(r.flags);
    const uint k = restir_pt_rc_vertex(r.flags);
    const bool nee = (r.flags & RESTIR_PT_LIGHT_NEE) != 0;
    RestirPTReservoir updated = r;
    // a light vertex is re-shaded by the reconnection itself, a replayed path is replayed whole
    if (k == 0 || (k == n && (r.flags & RESTIR_PT_LIGHT_ENV) == 0))
        return updated;
    if (k == n) {
        updated.rc_radiance = scene.eval_env_map(r.rc_wo, float3(0), prev_frame);
        return updated;
    }
    updated.rc_radiance = float3(0);

    // 1. from x_k along the direction the path took; a light sample is found where it was drawn
    TriangleHit tri;
    Surface surface;
    if (!restir_pt_hit_surface(scene, restir_pt_get_hit(r), prev_frame, tri, surface))
        return updated;
    const uint rc_lobe =
        restir_pt_record_lobe(restir_pt_lobe(r.flags, RESTIR_PT_LOBE_RC_SHIFT),
                              restir_pt_transmission(r.flags, RESTIR_PT_LOBE_RC_SHIFT));
    const float3 ng = surface.face_normal;
    RayDesc ray;
    ray.Origin = offset_ray_origin(surface.pos, ng, surface.spawn_offset, r.rc_wo);
    ray.Direction = r.rc_wo;
    ray.TMin = SCENE_RAY_TMIN;
    ray.TMax = SCENE_RAY_TMAX;
    const RestirPTRandom random = {r.seed};
    RestirPTFrom from;
    from.pos = surface.pos;
    // as a shading point stores it, so x_k finds the cell the path drew from
    from.face_normal = decode_normal(encode_normal(ng));
    from.spawn_offset = surface.spawn_offset;
    from.origin = ray.Origin;
    from.vertex = k;
    // only the MIS weight of the light right after x_k reads these
    from.pdf = 1.f;
    from.samples_lights =
        restir_pt_has_lights(scene, prev_frame) && (r.flags & RESTIR_PT_RC_SAMPLES_LIGHTS) != 0;
    Hit next = scene.trace_ray(ray, RAY_FLAG_NONE, merian_restir_pt_instance_mask, prev_frame);
    ShadingPoint sp = restir_pt_shading_point(scene, ray, next, k, k + 1 < n, prev_frame);
    if (k + 1 == n) {
        const float3 light_pos =
            scene.is_distant(next) ? surface.pos + ray.Direction * ENV_MAP_DISTANCE : sp.pos;
        if (nee) {
            path.connection(surface.pos, light_pos, k - 1, PATH_RECORD_METHOD_REPLAYED_LIGHT,
                            surface.material_id, path_record_surface(restir_pt_get_hit(r), false),
                            path_record_surface(next, scene.is_distant(next)));
        } else {
            path.vertex(surface.pos, r.rc_wo, k - 1, rc_lobe, PATH_RECORD_METHOD_REPLAYED_BSDF,
                        surface.material_id, path_record_surface(restir_pt_get_hit(r), false));
            path.light(light_pos, path_record_surface(next, scene.is_distant(next)));
        }
        updated.light_pdf =
            restir_pt_emitter_light_pdf(scene, random, from, r.rc_wo, next, prev_frame);
        updated.rc_radiance = sp.emission;
        return updated;
    }

    // 2. the vertices after it
    path.vertex(surface.pos, r.rc_wo, k - 1, rc_lobe, PATH_RECORD_METHOD_REPLAYED_BSDF,
                surface.material_id, path_record_surface(restir_pt_get_hit(r), false));
    const float roughness = RestirPTThresholds(r.seed).roughness;
    float3 throughput = float3(1);
    float3 wi = -r.rc_wo;
    for (uint i = k + 1;; i++) {
        if (i == n) {
            path.light(scene.is_distant(next) ? from.pos - wi * ENV_MAP_DISTANCE : sp.pos,
                       path_record_surface(next, scene.is_distant(next)));
            const float light_pdf =
                restir_pt_emitter_light_pdf(scene, random, from, -wi, next, prev_frame);
            updated.rc_radiance = throughput * sp.emission * (from.pdf / (from.pdf + light_pdf));
            return updated;
        }
        if (!sp.has_surface_material)
            return updated;
        let bsdf = sp.surface_material.get_bsdf();
        if (nee && i + 1 == n) {
            if (path.records())
                path.connection(sp.pos, restir_pt_kept_light_pos(scene, r, sp.pos, prev_frame),
                                i - 1, PATH_RECORD_METHOD_REPLAYED_LIGHT, sp.material_id,
                                path_record_surface(next, scene.is_distant(next)),
                                (r.flags & RESTIR_PT_LIGHT_ENV) != 0
                                    ? PATH_RECORD_SURFACE_ENVIRONMENT
                                    : path_record_surface(restir_pt_get_light(r), false));
            if (restir_pt_samples_lights(scene, bsdf, prev_frame))
                updated.rc_radiance = throughput * restir_pt_kept_light(scene, bsdf, sp, wi, r,
                                                                        random, i, prev_frame, rng);
            return updated;
        }
        const Optional<RestirPTScatter> sampled = restir_pt_scatter(bsdf, sp, wi, random, i, rng);
        if (!sampled.hasValue)
            return updated;
        const RestirPTScatter scatter = sampled.value;
        path.vertex(sp.pos, scatter.wo, i - 1,
                    restir_pt_record_lobe(scatter.lobe, scatter.transmission),
                    PATH_RECORD_METHOD_REPLAYED_BSDF, sp.material_id,
                    path_record_surface(next, scene.is_distant(next)));
        throughput *= scatter.f / scatter.pdf;
        from = restir_pt_from(scene, bsdf, sp, i, scatter, roughness, prev_frame);
        next =
            scene.trace_ray(scatter.ray, RAY_FLAG_NONE, merian_restir_pt_instance_mask, prev_frame);
        sp = restir_pt_shading_point(scene, scatter.ray, next, i, i + 1 < n, prev_frame);
        wi = -scatter.ray.Direction;
    }
    return updated;
}

// hybrid shift; fails where the destination would reconnect earlier [Lin et al. 2026, 4]
RestirPTShift restir_pt_shift<P : IRestirPTPathSink>(const ParameterBlock<Scene> scene,
                                                     const RestirPTPrimary primary,
                                                     const RestirPTReservoir r,
                                                     const bool prev_frame,
                                                     inout RandomGenerator rng,
                                                     inout P path) {
    const RestirPTShift failed = restir_pt_failed_shift();
    const uint n = restir_pt_light_vertex(r.flags);
    const uint k = restir_pt_rc_vertex(r.flags);
    if (n == 0)
        return failed;

    ShadingPoint sp = restir_pt_shading_point(scene, primary.ray, primary.hit, 0, true, prev_frame);
    // 1. a path that ends on the primary vertex, which the film sample places
    if (n == 1) {
        path.light(sp.pos, path_record_surface(primary.hit, scene.is_distant(primary.hit)));
        return {sp.emission, 1.f};
    }

    const uint end = k != 0 ? k - 1 : n;
    const RestirPTRandom random = {r.seed};
    const RestirPTThresholds thresholds = RestirPTThresholds(r.seed);
    const float footprint = restir_pt_primary_footprint(primary.ray, sp);
    const float limit = footprint * thresholds.distance;
    const bool hybrid = merian_restir_pt_shift_mapping == RestirPTShiftHybrid;

    Hit hit = primary.hit;
    float3 wi = -primary.ray.Direction;
    float3 throughput = float3(1);
    RestirPTFrom from;
    RestirPTSegment segment;

    // 2. replay up to x'_{k-1}, or up to the light vertex where k = 0
    for (uint i = 1; i < end; i++) {
        if (i > 1)
            segment = RestirPTSegment(from, sp, scene.is_distant(hit));
        if (!sp.has_surface_material)
            return failed;

        let bsdf = sp.surface_material.get_bsdf();
        const Optional<RestirPTScatter> sampled = restir_pt_scatter(bsdf, sp, wi, random, i, rng);
        if (!sampled.hasValue)
            return failed;
        const RestirPTScatter scatter = sampled.value;
        path.vertex(sp.pos, scatter.wo, i - 1,
                    restir_pt_record_lobe(scatter.lobe, scatter.transmission),
                    PATH_RECORD_METHOD_REPLAYED_BSDF, sp.material_id,
                    path_record_surface(hit, scene.is_distant(hit)));
        // a vertex before x_{k-1} that reconnects would have been the destination's x_k
        if (hybrid && i > 1 && segment.reconnects(scatter.footprint_pdf(), limit))
            return failed;

        throughput *= scatter.f / scatter.pdf;
        from = restir_pt_from(scene, bsdf, sp, i, scatter, thresholds.roughness, prev_frame);

        hit =
            scene.trace_ray(scatter.ray, RAY_FLAG_NONE, merian_restir_pt_instance_mask, prev_frame);
        sp = restir_pt_shading_point(scene, scatter.ray, hit, i, i + 1 < end || k != 0, prev_frame);
        wi = -scatter.ray.Direction;
    }
    if (end > 1)
        segment = RestirPTSegment(from, sp, scene.is_distant(hit));

    // 3. x'_{k-1}: reconnect from here
    if (k != 0) {
        const float inverse_geometry = end > 1 && segment.from_rough && segment.footprint >= limit
                                           ? segment.inverse_geometry
                                           : -1.f;
        return restir_pt_reconnect(scene, footprint, sp, hit, wi, throughput, inverse_geometry, r,
                                   prev_frame, rng, path);
    }

    // 4. the whole path was replayed: its light vertex must not reconnect either
    path.light(scene.is_distant(hit) ? from.pos - wi * ENV_MAP_DISTANCE : sp.pos,
               path_record_surface(hit, scene.is_distant(hit)));
    if (!any(sp.emission > 0.f) || (hybrid && segment.reconnects_emitter(limit)))
        return failed;
    const float light_pdf = restir_pt_emitter_light_pdf(scene, random, from, -wi, hit, prev_frame);
    RestirPTShift s;
    s.integrand = throughput * sp.emission * (from.pdf / (from.pdf + light_pdf));
    s.jacobian = 1.f;
    return all(isfinite(s.integrand)) ? s : failed;
}

} // namespace merian
