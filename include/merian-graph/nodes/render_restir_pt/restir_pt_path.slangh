#pragma once

// Path sampling for ReSTIR PT: the candidate paths of a pixel, and the replay of a path's random
// numbers in another domain, which is the first half of the hybrid shift [Lin et al. 2022, 7.3].
//
// Vertices are numbered from the primary hit x_1; x_n is the light vertex and x_k the
// reconnection vertex (k = 0 where the whole path is replayed).

#include "merian-graph/nodes/render_restir_pt/render_restir_pt.slangh"

#include "merian-shaders/utils/math-constants.slangh"

namespace merian {

extern static const int merian_restir_pt_max_path_length = 6;
extern static const bool merian_restir_pt_russian_roulette = true;
extern static const uint merian_restir_pt_roulette_depth = 2u;
extern static const uint merian_restir_pt_shift_mapping = RestirPTShiftHybrid;
extern static const bool merian_restir_pt_emission_on_primary = true;
// integrate over the pixel area and the lens [Zhang et al. 2024]
extern static const bool merian_restir_pt_area = false;
// the light cut learns from training paths, not from the paths the reservoirs reuse
extern static const bool merian_restir_pt_independent_feedback = true;
extern static const bool merian_restir_pt_retrace_suffix = true;
extern static const uint merian_restir_pt_instance_mask = 0xFFu;
// c of [Lin et al. 2026, eq. 5], relative to the primary footprint, with a relative jitter
extern static const float merian_restir_pt_min_footprint = 2e-4f;
extern static const float merian_restir_pt_footprint_jitter = 0.2f;
// linear roughness a glossy lobe needs to be reconnected from [Lin et al. 2026, 4.2]
extern static const float merian_restir_pt_min_roughness = 0.2f;
extern static const float merian_restir_pt_roughness_jitter = 0.f;

static const float RESTIR_PT_DELTA_PDF = 1e20f;

uint restir_pt_light_vertex(const uint flags) {
    return (flags >> RESTIR_PT_LIGHT_VERTEX_SHIFT) & RESTIR_PT_VERTEX_MASK;
}

uint restir_pt_rc_vertex(const uint flags) {
    return (flags >> RESTIR_PT_RC_VERTEX_SHIFT) & RESTIR_PT_VERTEX_MASK;
}

static const uint RESTIR_PT_LOBE_MASK = 0x3;
static const uint RESTIR_PT_LOBE_TRANSMISSION = 0x4;

uint restir_pt_lobe_bits(const RestirPTLobe lobe, const bool transmission) {
    return uint(lobe) | (transmission ? RESTIR_PT_LOBE_TRANSMISSION : 0u);
}

uint restir_pt_lobes(const uint prev_bits, const uint rc_bits) {
    return prev_bits | (rc_bits << (RESTIR_PT_LOBE_RC_SHIFT - RESTIR_PT_LOBE_PREV_SHIFT));
}

RestirPTLobe restir_pt_lobe(const uint flags, const uint shift) {
    return RestirPTLobe((flags >> shift) & RESTIR_PT_LOBE_MASK);
}

bool restir_pt_transmission(const uint flags, const uint shift) {
    return ((flags >> shift) & RESTIR_PT_LOBE_TRANSMISSION) != 0;
}

uint restir_pt_pack_unorm(const float2 v) {
    const uint2 q = uint2(round(saturate(v) * 65535.f));
    return q.x | (q.y << 16);
}

float2 restir_pt_unpack_unorm(const uint packed) {
    return float2(packed & 0xFFFFu, packed >> 16) / 65535.f;
}

uint restir_pt_geometry_id(const Hit hit) {
    return hit.is_valid() ? hit.get_geometry_id() : uint(-1);
}

void restir_pt_set_hit(inout RestirPTReservoir r, const Hit hit) {
    r.hit_geometry_id = restir_pt_geometry_id(hit);
    r.hit_primitive_id = hit.primitive_id;
    r.hit_instance_index = hit.instance_index;
    r.hit_barycentrics = hit.barycentrics;
}

Hit restir_pt_get_hit(const RestirPTReservoir r) {
    return Hit(r.hit_geometry_id, r.hit_instance_index, r.hit_primitive_id, 0, r.hit_barycentrics);
}

void restir_pt_set_light(inout RestirPTReservoir r, const Hit hit, const float3 env_dir) {
    r.light_geometry_id = restir_pt_geometry_id(hit);
    r.light_primitive_id = hit.primitive_id;
    r.light_instance_index = hit.instance_index;
    r.light_coords = hit.is_valid() ? hit.barycentrics : octahedral_project(env_dir);
}

Hit restir_pt_get_light(const RestirPTReservoir r) {
    return Hit(r.light_geometry_id, r.light_instance_index, r.light_primitive_id, 0,
               r.light_coords);
}

RestirPTReservoir restir_pt_from_prev_frame(const ParameterBlock<Scene> scene,
                                            RestirPTReservoir r) {
    if (scene.prev_geometry_remap_count == 0)
        return r;
    const Hit hit = scene.from_prev_frame(restir_pt_get_hit(r));
    r.hit_geometry_id = restir_pt_geometry_id(hit);
    r.hit_instance_index = hit.instance_index;
    const Hit light = scene.from_prev_frame(restir_pt_get_light(r));
    r.light_geometry_id = restir_pt_geometry_id(light);
    r.light_instance_index = light.instance_index;
    return r;
}

// false where the hit has no surface in the frame of `prev_frame`
bool restir_pt_hit_surface(const ParameterBlock<Scene> scene,
                           const Hit hit,
                           const bool prev_frame,
                           out TriangleHit tri,
                           out Surface surface) {
    if (!hit.is_valid() || !scene.exists(hit, prev_frame))
        return false;
    tri = scene.get_triangle_hit(hit, prev_frame);
    surface = scene.get_surface(hit, tri, prev_frame);
    // fails for NaN triangles as well
    return surface.area > 0.f;
}

RestirPTReservoir restir_pt_empty_reservoir() {
    RestirPTReservoir r;
    r.M = 0.f;
    r.W = 0.f;
    r.integrand = float3(0);
    r.seed = 0;
    r.flags = 0;
    restir_pt_set_hit(r, Hit());
    restir_pt_set_light(r, Hit(), float3(0, 0, 1));
    r.rc_wo = float3(0, 0, 1);
    r.rc_radiance = float3(0);
    r.rc_geometry = 1.f;
    r.light_pdf = 0.f;
    r.film = 0;
    return r;
}

// Each vertex draws its scatter direction and its light sample from streams of its own, so a
// replay in another domain reproduces them whatever the rest of the path consumed.
struct RestirPTRandom {
    uint seed;

    PCG scatter(const uint vertex) {
        return PCG(xxhash32(uint3(seed, vertex, 0x5CA7u)));
    }

    PCG light(const uint vertex) {
        return PCG(xxhash32(uint3(seed, vertex, 0x119Bu)));
    }

    // where the primary ray passes the pixel, as a reservoir stores it
    uint film() {
        PCG rng = PCG(xxhash32(uint2(seed, 0xF11Au)));
        return restir_pt_pack_unorm(rng.next_float2());
    }

    // where it passes the lens
    float2 lens() {
        PCG rng = PCG(xxhash32(uint2(seed, 0x1E45u)));
        return rng.next_float2();
    }
}

// The point of the image a reservoir's primary ray passes through, relative to `origin`.
float2 restir_pt_image_pos(const float2 origin, const RestirPTReservoir r) {
    return merian_restir_pt_area ? origin + restir_pt_unpack_unorm(r.film) : origin;
}

float restir_pt_gauss(const float mean, const float relative_sigma, inout RandomGenerator rng) {
    const float2 u = rng.next_float2();
    const float z = sqrt(-2.f * log(1.f - u.x)) * cos(MERIAN_TWO_PI * u.y);
    return mean + z * relative_sigma * mean;
}

// Reconnection thresholds of one path, jittered so the boundary between replay and reconnection
// does not show [Lin et al. 2026, 4.3]. Seeded by the path, so every domain agrees on them.
struct RestirPTThresholds {
    float distance;
    float roughness;

    __init(const uint seed) {
        RandomGenerator rng = PCG(xxhash32(uint2(seed, 0x7E5Du)));
        distance =
            restir_pt_gauss(merian_restir_pt_min_footprint, merian_restir_pt_footprint_jitter, rng);
        roughness =
            restir_pt_gauss(merian_restir_pt_min_roughness, merian_restir_pt_roughness_jitter, rng);
    }
}

struct RestirPTPrimary {
    Hit hit;
    RayDesc ray;
}

// Area the pixel's cone covers at the primary vertex, scaled by 4 pi [Lin et al. 2026, eq. 5].
float restir_pt_primary_footprint(const RayDesc ray, const ShadingPoint sp) {
    const float3 d = sp.pos - ray.Origin;
    return MERIAN_FOUR_PI * dot(d, d) / max(abs(dot(sp.get_face_normal(), ray.Direction)), 1e-6f);
}

// `image_pos` in pixels, without the jitter; through `lens` where the camera has an aperture
RayDesc restir_pt_film_ray(const Camera camera,
                           const float2 image_pos,
                           const uint2 dim,
                           const float2 lens) {
    const float2 ndc = float2(2, -2) * (image_pos / float2(dim)) + float2(-1, 1);
    const float3 focus = ndc.x * camera.U + ndc.y * camera.V + camera.W;
    float3 offset = float3(0);
    if (merian_hint_enable_thin_lens && camera.aperture_radius > 0.f) {
        const float2 disk = sample_disk(lens);
        offset =
            camera.aperture_radius * (disk.x * normalize(camera.U) + disk.y * normalize(camera.V));
    }
    RayDesc ray;
    ray.Origin = camera.position + offset;
    ray.Direction = normalize(focus - offset);
    const float inv_cos = 1.f / dot(normalize(camera.W), ray.Direction);
    ray.TMin = camera.near * inv_cos;
    ray.TMax = camera.far * inv_cos;
    return ray;
}

// The primary vertex a path takes through `image_pos` in a domain. With the pixel area integrated,
// the ray is traced through that point and the lens sample of the path's seed; otherwise it is
// the GBuffer's hit of the pixel.
RestirPTPrimary restir_pt_primary(const ParameterBlock<Scene> scene,
                                  const GBuffer gbuffer,
                                  const bool prev_frame,
                                  const float2 image_pos,
                                  const uint2 dim,
                                  const uint seed) {
    const Camera camera = prev_frame ? scene.prev_camera : scene.camera;
    RestirPTPrimary v;
    if (merian_restir_pt_area) {
        const RestirPTRandom random = {seed};
        v.ray = restir_pt_film_ray(camera, image_pos, dim, random.lens());
        v.hit = scene.trace_ray(v.ray, RAY_FLAG_NONE, gbuffer.get_instance_mask(), prev_frame);
    } else {
        const uint2 pixel = uint2(image_pos);
        v.ray = camera.generate_ray_pinhole(pixel, dim);
        v.hit = gbuffer.get_hit(pixel);
        if (prev_frame)
            v.hit = scene.from_prev_frame(v.hit);
    }
    return v;
}

// where the ray from `lens` to `x` crosses the image, and the film density per area at `x`
struct RestirPTProjection {
    float2 image_pos;
    float density;
}

Optional<RestirPTProjection>
restir_pt_project(const Camera camera,
                  const float3 x,
                  const float3 n,
                  const bool distant,
                  const uint2 dim,
                  const float2 lens) {
    const float3 u = normalize(camera.U);
    const float3 v = normalize(camera.V);
    const float3 w = normalize(camera.W);
    float2 lens_pos = float2(0);
    if (merian_hint_enable_thin_lens && camera.aperture_radius > 0.f)
        lens_pos = camera.aperture_radius * sample_disk(lens);
    const float3 d = distant ? x : x - (camera.position + lens_pos.x * u + lens_pos.y * v);
    const float dist2 = distant ? 1.f : dot(d, d);
    const float3 dir = d * rsqrt(dot(d, d));
    const float cos_w = dot(w, dir);
    if (!(cos_w > 0.f))
        return none;
    const float2 plane = lens_pos + length(camera.W) / cos_w * float2(dot(dir, u), dot(dir, v));
    const float2 ndc = plane / float2(length(camera.U), length(camera.V));
    const float2 image_pos = float2(0.5f * ndc.x + 0.5f, 0.5f - 0.5f * ndc.y) * float2(dim);
    if (!(all(image_pos >= 0.f) && all(image_pos < float2(dim))))
        return none;
    RestirPTProjection p;
    p.image_pos = image_pos;
    p.density = (distant ? 1.f : abs(dot(n, dir)) / dist2) / (cos_w * cos_w * cos_w);
    return p;
}

// A primary vertex of one frame seen from the other frame's camera: where it lands on that image
// and the Jacobian between the film areas of both [Liu et al. 2025].
struct RestirPTSplat {
    float2 image_pos;
    float jacobian;
}

Optional<RestirPTSplat>
restir_pt_splat(const ParameterBlock<Scene> scene,
                const RestirPTPrimary primary,
                const bool to_prev,
                const uint dst_mask,
                const uint2 dim,
                const uint seed) {
    if (!scene.exists(primary.hit, to_prev))
        return none;
    const RestirPTRandom random = {seed};
    const float2 lens = random.lens();
    const Camera src_camera = to_prev ? scene.camera : scene.prev_camera;
    const Camera dst_camera = to_prev ? scene.prev_camera : scene.camera;
    const bool distant = scene.is_distant(primary.hit);
    float3 src_x = primary.ray.Direction;
    float3 dst_x = src_x;
    float3 src_n = float3(0);
    float3 dst_n = float3(0);
    float dst_offset = 0.f;
    // the vertex keeps its barycentrics, so its triangle's area change is part of the Jacobian
    float area_ratio = 1.f;
    if (!distant) {
        const TriangleHit tri = scene.get_triangle_hit(primary.hit);
        const Surface now = scene.get_surface(primary.hit, tri);
        const Surface prev =
            scene.get_surface(primary.hit, scene.get_triangle_hit(primary.hit, tri, true), true);
        src_x = to_prev ? now.pos : prev.pos;
        src_n = to_prev ? now.face_normal : prev.face_normal;
        dst_x = to_prev ? prev.pos : now.pos;
        dst_n = to_prev ? prev.face_normal : now.face_normal;
        dst_offset = to_prev ? prev.spawn_offset : now.spawn_offset;
        // fails for NaN triangles as well
        if (!(now.area > 0.f) || !(prev.area > 0.f))
            return none;
        area_ratio = to_prev ? prev.area / now.area : now.area / prev.area;
    }
    const Optional<RestirPTProjection> src =
        restir_pt_project(src_camera, src_x, src_n, distant, dim, lens);
    const Optional<RestirPTProjection> dst =
        restir_pt_project(dst_camera, dst_x, dst_n, distant, dim, lens);
    if (!src.hasValue || !dst.hasValue || !(src.value.density > 0.f))
        return none;

    // the vertex must be what the other camera sees there
    const RayDesc ray = restir_pt_film_ray(dst_camera, dst.value.image_pos, dim, lens);
    const float3 target = distant ? ray.Origin + ray.Direction * ENV_MAP_DISTANCE
                                  : offset_ray_origin(dst_x, dst_n, dst_offset, -ray.Direction);
    if (!scene.trace_light_visibility(ray.Origin, ray.Direction, 0.f, target, distant, dst_mask,
                                      to_prev))
        return none;

    RestirPTSplat s;
    s.image_pos = dst.value.image_pos;
    s.jacobian = dst.value.density / src.value.density * area_ratio;
    if (!isfinite(s.jacobian))
        return none;
    return s;
}

RestirPTLobe restir_pt_sample_lobe(const BSDFLobe lobe) {
    if (bsdf_lobe_is_delta(lobe))
        return RestirPTLobeDelta;
    const uint glossy = uint(BSDFLobe::GlossyReflection) | uint(BSDFLobe::GlossyTransmission);
    return (uint(lobe) & glossy) != 0 ? RestirPTLobeGlossy : RestirPTLobeDiffuse;
}

// Whether `bsdf` is rough enough to reconnect from [Lin et al. 2026, 4.2].
bool restir_pt_is_rough<B : BSDF>(const B bsdf, const float threshold) {
    return sqrt(bsdf.effective_alpha) > threshold;
}

bool restir_pt_bsdf_samples_lights<B : BSDF>(const B bsdf) {
    return bsdf.effective_alpha >= NEE_MIN_ALPHA;
}

bool restir_pt_has_lights(const ParameterBlock<Scene> scene, const bool prev_frame) {
    return prev_frame ? scene.prev_nee.has_lights() : scene.nee.has_lights();
}

DirectLightVertex restir_pt_begin_light_vertex(const ParameterBlock<Scene> scene,
                                               const bool prev_frame,
                                               const float3 pos,
                                               const float3 face_normal,
                                               const float spawn_offset,
                                               inout RandomGenerator light_rng) {
    return prev_frame ? scene.prev_nee.begin_vertex(pos, face_normal, spawn_offset, float3(0),
                                                    light_rng, false)
                      : scene.nee.begin_vertex(pos, face_normal, spawn_offset, float3(0), light_rng,
                                               !merian_restir_pt_independent_feedback);
}

float restir_pt_light_point_pdf(const ParameterBlock<Scene> scene,
                                const bool prev_frame,
                                const DirectLightVertex vertex,
                                const uint index,
                                const float3 light_pos,
                                const float3 light_normal) {
    return prev_frame ? scene.prev_nee.pdf_point(vertex, index, light_pos, light_normal)
                      : scene.nee.pdf_point(vertex, index, light_pos, light_normal);
}

float restir_pt_light_hit_pdf(const ParameterBlock<Scene> scene,
                              const bool prev_frame,
                              const DirectLightVertex vertex,
                              const uint index,
                              const float2 barycentrics,
                              const float3 origin,
                              const float3 dir) {
    return prev_frame ? scene.prev_nee.pdf(vertex, index, origin, dir, barycentrics, false)
                      : scene.nee.pdf(vertex, index, origin, dir, barycentrics, false);
}

bool restir_pt_samples_lights<B : BSDF>(const ParameterBlock<Scene> scene,
                                        const B bsdf,
                                        const bool prev_frame) {
    return restir_pt_has_lights(scene, prev_frame) && restir_pt_bsdf_samples_lights(bsdf);
}

struct RestirPTFrom {
    float3 pos;
    float3 face_normal;
    float spawn_offset;
    float3 origin;
    uint vertex;
    // |cos| between its face normal and the direction drawn there
    float cos;
    // solid angle density of that direction, RESTIR_PT_DELTA_PDF for a delta lobe
    float pdf;
    // RestirPTLobe and transmission, as restir_pt_lobe_bits
    uint lobes;
    bool rough;
    // light sampling ran there, so an emitter reached from it is weighed against it
    bool samples_lights;

    // the density that turns the direction from primary sample space to solid angle
    float measure() {
        return pdf == RESTIR_PT_DELTA_PDF ? 1.f : pdf;
    }
}

// footprints are areas at the far end of the segment [Lin et al. 2026, eq. 5]
struct RestirPTSegment {
    // |cos| at x_i over the squared length; 1 for the environment
    float geometry;
    // geometry times the area of x_i's triangle
    float rc_geometry;
    // the squared length over |cos| at x_{i-1}: the area x_i's own lobe covers at x_{i-1}
    float inverse_geometry;
    // the area x_{i-1}'s lobe covers at x_i
    float footprint;
    bool distant;
    bool from_rough;

    __init(const RestirPTFrom from, const ShadingPoint sp, const bool distant) {
        this.distant = distant;
        from_rough = from.rough;
        if (distant) {
            geometry = 1.f;
            rc_geometry = 1.f;
            inverse_geometry = MERIAN_FLT_MAX;
            footprint = MERIAN_FLT_MAX;
            return;
        }
        const float3 d = sp.pos - from.origin;
        const float dist2 = dot(d, d);
        geometry = abs(dot(sp.get_face_normal(), d * rsqrt(dist2))) / dist2;
        rc_geometry = geometry * sp.area;
        inverse_geometry = dist2 / max(from.cos, 1e-6f);
        footprint = 1.f / (geometry * from.pdf);
    }

    // [Lin et al. 2026, eq. 5]; `pdf` is the density of the direction leaving x_i
    bool reconnects(const float pdf, const float limit) {
        return from_rough && min(footprint, inverse_geometry / pdf) >= limit;
    }

    // An emitter has no lobe of its own; it counts as diffuse.
    bool reconnects_emitter(const float limit) {
        return distant ? from_rough : reconnects(MERIAN_INV_TWO_PI, limit);
    }
}

ShadingPoint
restir_pt_shading_point(const ParameterBlock<Scene> scene,
                        const RayDesc ray,
                        const Hit hit,
                        const uint vertex,
                        const bool with_material,
                        const bool prev_frame) {
    return scene.get_shading_point(ray, hit, RenderContext(uint16_t(vertex)), DefaultLODSampler(),
                                   with_material, prev_frame);
}

struct RestirPTScatter {
    float3 wo;
    // f cos, the sample weight for a delta lobe
    float3 f;
    // solid angle density, 1 for a delta lobe
    float pdf;
    RestirPTLobe lobe;
    bool transmission;
    RayDesc ray;

    bool is_delta() {
        return lobe == RestirPTLobeDelta;
    }

    // the density the footprint criteria see; a delta lobe covers no area
    float footprint_pdf() {
        return is_delta() ? RESTIR_PT_DELTA_PDF : pdf;
    }
}

// Draws the scatter direction of vertex `vertex` from the path's own stream, so a replay in
// another domain draws it from the same random numbers.
Optional<RestirPTScatter> restir_pt_scatter<B : BSDF>(const B bsdf,
                                                      const ShadingPoint sp,
                                                      const float3 wi,
                                                      const RestirPTRandom random,
                                                      const uint vertex,
                                                      inout RandomGenerator rng) {
    const OrthonormalFrame frame = sp.shading_frame;
    const float3 wi_local = frame.to_local(wi);
    RandomGenerator scatter_rng = random.scatter(vertex);
    if (let sample = bsdf.sample_eval(wi_local, scatter_rng)) {
        RestirPTScatter s;
        s.lobe = restir_pt_sample_lobe(sample.lobe);
        const float3 wo_local = sample.wo;
        s.f = s.is_delta() ? sample.weight : sample.weight * sample.pdf;
        s.pdf = s.is_delta() ? 1.f : sample.pdf;
        if (!any(s.f > 0.f) || !(s.pdf > 0.f))
            return none;
        s.transmission = wi_local.z * wo_local.z < 0.f;
        s.wo = frame.to_world(wo_local);
        if (let ray = sp.make_ray(wi, s.wo, s.transmission)) {
            s.ray = ray;
            return s;
        }
    }
    return none;
}

RestirPTFrom restir_pt_from<B : BSDF>(const ParameterBlock<Scene> scene,
                                      const B bsdf,
                                      const ShadingPoint sp,
                                      const uint vertex,
                                      const RestirPTScatter scatter,
                                      const float min_roughness,
                                      const bool prev_frame) {
    RestirPTFrom from;
    from.pos = sp.pos;
    from.face_normal = sp.get_face_normal();
    from.spawn_offset = sp.spawn_offset;
    from.origin = scatter.ray.Origin;
    from.vertex = vertex;
    from.cos = abs(dot(from.face_normal, scatter.wo));
    from.pdf = scatter.footprint_pdf();
    from.lobes = restir_pt_lobe_bits(scatter.lobe, scatter.transmission);
    from.rough = !scatter.is_delta() && restir_pt_is_rough(bsdf, min_roughness);
    from.samples_lights = restir_pt_samples_lights(scene, bsdf, prev_frame) && !scatter.is_delta();
    return from;
}

// summed over the draws; 0 where no light was sampled there
float restir_pt_emitter_light_pdf(const ParameterBlock<Scene> scene,
                                  const RestirPTRandom random,
                                  const RestirPTFrom from,
                                  const float3 dir,
                                  const Hit hit,
                                  const bool prev_frame) {
    if (!from.samples_lights)
        return 0.f;
    RandomGenerator light_rng = random.light(from.vertex);
    const DirectLightVertex vertex = restir_pt_begin_light_vertex(
        scene, prev_frame, from.pos, from.face_normal, from.spawn_offset, light_rng);
    return restir_pt_light_hit_pdf(scene, prev_frame, vertex,
                                   scene.get_light_index(hit, prev_frame), hit.barycentrics,
                                   from.origin, dir);
}

struct RestirPTLightTarget<B : BSDF> : IDirectLightTarget {
    B bsdf;
    OrthonormalFrame frame;
    float3 wi;
    float3 wi_local;
    float3 face_normal;

    bool receives(const float3 wo) {
        const bool transmission = wi_local.z * frame.to_local(wo).z < 0.f;
        return ((dot(wi, face_normal) < 0.f) != (dot(wo, face_normal) < 0.f)) == transmission;
    }

    float3 unshadowed(const LightSample ls, inout RandomGenerator rng, out float scatter_pdf) {
        return bsdf.eval_pdf(wi_local, frame.to_local(ls.wo), rng, scatter_pdf) * ls.Li;
    }
}

// generalized balance heuristic [Bitterli et al. 2020]; `record`: the light cut learns from it
Optional<DirectLightSample> restir_pt_direct<B : BSDF>(const ParameterBlock<Scene> scene,
                                                       const B bsdf,
                                                       const ShadingPoint sp,
                                                       const float3 wi,
                                                       const RestirPTRandom random,
                                                       const uint vertex,
                                                       const bool record,
                                                       out bool visible) {
    RandomGenerator light_rng = random.light(vertex);
    const DirectLightVertex light_vertex = scene.nee.begin_vertex(
        sp.pos, sp.get_face_normal(), sp.spawn_offset, float3(0), light_rng, record);
    const RestirPTLightTarget<B> target = {bsdf, sp.shading_frame, wi,
                                           sp.shading_frame.to_local(wi), sp.get_face_normal()};
    let s = scene.sample_direct_light(light_vertex, target, light_rng, record);
    if (!s.hasValue)
        visible = false;
    else if (record)
        visible = scene.trace_direct_light(light_vertex, s.value, light_rng,
                                           merian_restir_pt_instance_mask);
    else
        visible = scene.trace_light_visibility(light_vertex.pos, light_vertex.face_normal,
                                               light_vertex.spawn_offset, s.value.light.pos,
                                               s.value.light.index == LIGHT_ENV_INDEX,
                                               merian_restir_pt_instance_mask);
    return s;
}

void restir_pt_train(const ParameterBlock<Scene> scene,
                     const RestirPTPrimary primary,
                     const uint seed,
                     inout RandomGenerator rng) {
    const RestirPTRandom random = {seed};
    const uint max_length = uint(merian_restir_pt_max_path_length);
    ShadingPoint sp = scene.get_shading_point(primary.ray, primary.hit);
    float3 wi = -primary.ray.Direction;
    float3 throughput = float3(1);
    for (uint i = 1; i < max_length && sp.has_surface_material && any(throughput > 0.f); i++) {
        let bsdf = sp.surface_material.get_bsdf();
        if (restir_pt_samples_lights(scene, bsdf, false)) {
            bool visible;
            restir_pt_direct(scene, bsdf, sp, wi, random, i, true, visible);
        }
        if (i + 1 == max_length)
            return;
        if (merian_restir_pt_russian_roulette && i > merian_restir_pt_roulette_depth) {
            const float survive = russian_roulette_survival(throughput);
            if (!(rng.next_float() < survive))
                return;
            throughput /= survive;
        }
        const Optional<RestirPTScatter> sampled = restir_pt_scatter(bsdf, sp, wi, random, i, rng);
        if (!sampled.hasValue)
            return;
        throughput *= sampled.value.f / sampled.value.pdf;
        const Hit hit =
            scene.trace_ray(sampled.value.ray, RAY_FLAG_NONE, merian_restir_pt_instance_mask);
        sp = scene.get_shading_point(sampled.value.ray, hit, RenderContext(uint16_t(i)),
                                     DefaultLODSampler(), true);
        wi = -sampled.value.ray.Direction;
    }
}

// BSDF, emission, geometry term times triangle area and MIS weight of the kept light sample
float3 restir_pt_kept_light<B : BSDF>(const ParameterBlock<Scene> scene,
                                      const B bsdf,
                                      const ShadingPoint sp,
                                      const float3 wi,
                                      const RestirPTReservoir r,
                                      const RestirPTRandom random,
                                      const uint vertex,
                                      const bool prev_frame,
                                      inout RandomGenerator rng) {
    const bool distant = (r.flags & RESTIR_PT_LIGHT_ENV) != 0;
    const float3 ng = sp.get_face_normal();
    RandomGenerator light_rng = random.light(vertex);
    const DirectLightVertex light_vertex =
        restir_pt_begin_light_vertex(scene, prev_frame, sp.pos, ng, sp.spawn_offset, light_rng);
    float3 dir = octahedral_unproject(r.light_coords);
    float geometry = 1.f;
    float3 light_normal = -dir;
    float3 target = sp.pos + dir * ENV_MAP_DISTANCE;
    float3 light_pos = target;
    uint index = LIGHT_ENV_INDEX;
    float3 Le;
    if (distant) {
        Le = scene.eval_env_map(dir, sp.pos, prev_frame);
    } else {
        const Hit hit = restir_pt_get_light(r);
        TriangleHit tri;
        Surface surface;
        if (!restir_pt_hit_surface(scene, hit, prev_frame, tri, surface))
            return float3(0);
        light_pos = surface.pos;
        const float3 d = light_pos - light_vertex.origin(light_pos);
        const float dist2 = dot(d, d);
        dir = d * rsqrt(dist2);
        light_normal = surface.face_normal;
        geometry = abs(dot(light_normal, dir)) / dist2 * surface.area;
        RayDesc ray;
        ray.Origin = sp.pos;
        ray.Direction = dir;
        ray.TMin = 0.f;
        ray.TMax = SCENE_RAY_TMAX;
        Le = scene
                 .get_shading_point(ray, hit, tri, surface, RenderContext(uint16_t(vertex)),
                                    DefaultLODSampler(), false, prev_frame)
                 .emission;
        index = scene.get_light_index(hit, prev_frame);
        target = offset_ray_origin(surface.pos, surface.face_normal, surface.spawn_offset, -dir);
    }

    const OrthonormalFrame frame = sp.shading_frame;
    const float3 wi_local = frame.to_local(wi);
    const float3 wo_local = frame.to_local(dir);
    if (!any(Le > 0.f) || !sp.geometric_side_agrees(wi, dir, wi_local.z * wo_local.z < 0.f))
        return float3(0);
    float p_scatter;
    const float3 f = bsdf.eval_pdf(wi_local, wo_local, rng, p_scatter);
    const float p_light =
        restir_pt_light_point_pdf(scene, prev_frame, light_vertex, index, light_pos, light_normal);
    if (!any(f > 0.f) || !(p_light > 0.f) ||
        !scene.trace_light_visibility(sp.pos, ng, sp.spawn_offset, target, distant,
                                      merian_restir_pt_instance_mask, prev_frame))
        return float3(0);
    return f * Le * (geometry * p_light / (p_light + p_scatter));
}

struct RestirPTRunningRc {
    uint k;
    // p_{k-1} p_k: turns both segments around x_k from primary sample space to solid angle
    float measure;
    // f / p of the vertices after x_k
    float3 throughput;

    __init() {
        k = 0;
        measure = 1.f;
        throughput = float3(1);
    }
}

// Streaming RIS over the light-carrying subpaths of a pixel's paths. Their domains are disjoint,
// so each enters with m_i = 1 and the target cancels against the contribution weight. The
// selected candidate goes to memory as soon as it is selected, so it is not carried along the
// path.
struct RestirPTCandidates {
    RestirPTReservoirAddress selected;
    // x_k, how the path leaves it, its lobes and geometry term, once the path has one
    RestirPTReservoirAddress running;
    uint seed;
    float weight_sum;

    [mutating] bool select(const float3 contribution, inout RandomGenerator rng) {
        const float weight = yuv_luminance(contribution);
        if (!(weight > 0.f) || !isfinite(weight))
            return false;
        weight_sum += weight;
        return rng.next_float() * weight_sum < weight;
    }

    void write(const RestirPTReservoir r) {
        *selected = r;
    }

    void write_running(const uint n,
                       const uint k,
                       const bool nee,
                       const bool env,
                       const float3 integrand,
                       const float3 radiance,
                       const float light_pdf,
                       const Hit light = Hit(),
                       const float3 light_dir = float3(0, 0, 1)) {
        RestirPTReservoir r = *running;
        r.seed = seed;
        r.integrand = integrand;
        r.flags = restir_pt_flags(n, k, nee, env, 0) | r.flags;
        r.rc_radiance = radiance;
        r.light_pdf = light_pdf;
        restir_pt_set_light(r, light, light_dir);
        write(r);
    }
}

uint restir_pt_flags(const uint n, const uint k, const bool nee, const bool env, const uint lobes) {
    return (n << RESTIR_PT_LIGHT_VERTEX_SHIFT) | (k << RESTIR_PT_RC_VERTEX_SHIFT) |
           (nee ? RESTIR_PT_LIGHT_NEE : 0u) | (env ? RESTIR_PT_LIGHT_ENV : 0u) |
           (lobes << RESTIR_PT_LOBE_PREV_SHIFT);
}

// A selected candidate as a reservoir, before its contribution weight is known.
RestirPTReservoir restir_pt_candidate(const uint seed,
                                      const float3 integrand,
                                      const uint flags,
                                      const Hit hit,
                                      const float3 rc_wo,
                                      const float3 rc_radiance,
                                      const float rc_geometry,
                                      const float light_pdf) {
    RestirPTReservoir r = restir_pt_empty_reservoir();
    r.seed = seed;
    if (merian_restir_pt_area) {
        const RestirPTRandom random = {seed};
        r.film = random.film();
    }
    r.integrand = integrand;
    r.flags = flags;
    restir_pt_set_hit(r, hit);
    r.rc_wo = rc_wo;
    r.rc_radiance = rc_radiance;
    r.rc_geometry = rc_geometry;
    r.light_pdf = light_pdf;
    return r;
}

uint restir_pt_record_lobe(const RestirPTLobe lobe, const bool transmission) {
    const uint smoothness = lobe == RestirPTLobeDelta    ? PATH_RECORD_LOBE_DELTA
                            : lobe == RestirPTLobeGlossy ? PATH_RECORD_LOBE_GLOSSY
                                                         : PATH_RECORD_LOBE_DIFFUSE;
    return smoothness | (transmission ? PATH_RECORD_LOBE_TRANSMISSION : 0u);
}

// The light sample of a vertex, kept until the vertex it branches off is recorded.
struct RestirPTLightRecord {
    bool drawn;
    float3 pos;
    float pdf;
    float3 throughput;
    float3 contribution;

    __init() {
        drawn = false;
        pos = float3(0);
        pdf = 0.f;
        throughput = float3(0);
        contribution = float3(0);
    }

    void record(inout PathRecorder rec,
                const PathRecordStream records,
                const float3 from,
                const uint bounce,
                const uint material) {
        if (drawn)
            rec.connection(records, from, pdf > 0.f ? pos : from, pdf, throughput, contribution,
                           bounce, PATH_RECORD_METHOD_LIGHT, material);
    }
}

// Traces one path from `primary` and resamples its light-carrying subpaths into `candidates`.
// Returns the emission of the primary vertex where it is not resampled.
float3 restir_pt_trace_candidates(const ParameterBlock<Scene> scene,
                                  const RestirPTPrimary primary,
                                  inout RestirPTCandidates candidates,
                                  inout RandomGenerator rng,
                                  const PathRecordStream records,
                                  inout PathRecorder rec) {
    const uint seed = candidates.seed;
    const RestirPTRandom random = {seed};
    const RestirPTThresholds thresholds = RestirPTThresholds(seed);
    ShadingPoint sp = scene.get_shading_point(primary.ray, primary.hit);
    const float limit = restir_pt_primary_footprint(primary.ray, sp) * thresholds.distance;
    const bool hybrid = merian_restir_pt_shift_mapping == RestirPTShiftHybrid;
    const uint max_length = uint(merian_restir_pt_max_path_length);

    float3 primary_emission = float3(0);
    // f / p along the path, with the russian roulette weights
    float3 throughput = float3(1);
    // survival probability of the russian roulette, which the target function leaves out
    float roulette = 1.f;
    RestirPTRunningRc rc = RestirPTRunningRc();

    Hit hit = primary.hit;
    float3 wi = -primary.ray.Direction;
    RestirPTFrom from;

    for (uint i = 1;; i++) {
        const bool distant = i > 1 && scene.is_distant(hit);
        RestirPTSegment segment;
        if (i > 1)
            segment = RestirPTSegment(from, sp, distant);

        // 1. emission, reached by the scatter technique from x_{i-1}
        if (i == 1) {
            if (merian_restir_pt_emission_on_primary) {
                if (!merian_restir_pt_area) {
                    primary_emission = sp.emission;
                } else if (any(sp.emission > 0.f) && candidates.select(sp.emission, rng)) {
                    candidates.write(restir_pt_candidate(
                        seed, sp.emission,
                        restir_pt_flags(1, 0, false, !sp.has_surface_material, 0), Hit(), wi,
                        sp.emission, 1.f, 0.f));
                }
                rec.emission(sp.emission);
            }
        } else if (any(sp.emission > 0.f)) {
            const float light_pdf =
                restir_pt_emitter_light_pdf(scene, random, from, -wi, hit, false);
            const float mis = from.pdf / (from.pdf + light_pdf);
            const float3 contribution = throughput * sp.emission * mis;
            rec.emission(contribution);
            if (candidates.select(contribution, rng)) {
                if (rc.k != 0) {
                    candidates.write_running(
                        i, rc.k, false, distant, contribution * roulette * rc.measure,
                        rc.k == i - 1 ? sp.emission : rc.throughput * sp.emission * mis, light_pdf);
                } else if (hybrid ? segment.reconnects_emitter(limit) : i == 2) {
                    candidates.write(restir_pt_candidate(
                        seed, contribution * roulette * from.measure(),
                        restir_pt_flags(i, i, false, distant, from.lobes), distant ? Hit() : hit,
                        -wi, sp.emission, segment.rc_geometry, 0.f));
                } else {
                    candidates.write(
                        restir_pt_candidate(seed, contribution * roulette,
                                            restir_pt_flags(i, 0, false, distant, from.lobes),
                                            Hit(), -wi, sp.emission, 1.f, 0.f));
                }
            }
        }

        if (i >= max_length || !sp.has_surface_material || all(throughput <= 0.f)) {
            rec.terminal(records, sp.pos);
            break;
        }

        const OrthonormalFrame frame = sp.shading_frame;
        let bsdf = sp.surface_material.get_bsdf();
        const float3 wi_local = frame.to_local(wi);
        const float3 ng = sp.get_face_normal();
        const bool samples_lights = restir_pt_samples_lights(scene, bsdf, false);
        const uint material = path_record_pack_material(sp.material_id);
        RestirPTLightRecord light_record = RestirPTLightRecord();

        // 2. next event estimation towards x_{i+1}
        if (samples_lights) {
            light_record.drawn = true;
            bool visible;
            let resampled = restir_pt_direct(scene, bsdf, sp, wi, random, i,
                                             !merian_restir_pt_independent_feedback, visible);
            if (resampled.hasValue) {
                light_record.pos = resampled.value.light_point;
                light_record.pdf = resampled.value.realized_pdf;
            }
            if (visible) {
                const DirectLightSample direct = resampled.value;
                const float3 contribution = throughput * direct.value;
                const bool env = direct.light.index == LIGHT_ENV_INDEX;
                light_record.throughput =
                    select(direct.light.Li > 0.f, contribution / direct.light.Li, float3(0));
                light_record.contribution = contribution;
                if (candidates.select(contribution, rng)) {
                    // per area of the light's triangle
                    float light_geometry = 1.f;
                    if (!env) {
                        const float3 n = scene.nee.get_normal(direct.light.index);
                        light_geometry = abs(dot(n, direct.light.wo)) /
                                         (direct.light.dist * direct.light.dist) *
                                         scene.nee.get_area(direct.light.index);
                    }
                    const uint light_lobe = restir_pt_lobe_bits(
                        RestirPTLobeDiffuse, dot(wi, ng) * dot(direct.light.wo, ng) < 0.f);
                    if (rc.k != 0) {
                        // the integrand is measured on the light
                        const float light_density = direct.realized_pdf * light_geometry;
                        candidates.write_running(
                            i + 1, rc.k, true, env,
                            contribution * roulette * rc.measure * light_density,
                            rc.throughput * direct.value * light_density, 0.f,
                            env ? Hit()
                                : scene.get_emitter_hit(direct.light.index, direct.light_point),
                            direct.light.wo);
                    } else if (i > 1 &&
                               (hybrid ? segment.reconnects(direct.scatter_pdf, limit) : i == 2)) {
                        // x_i reconnects, with the light sample leaving it
                        const uint lobes = restir_pt_lobes(from.lobes, light_lobe);
                        candidates.write(restir_pt_candidate(
                            seed, contribution * roulette * from.measure() * direct.realized_pdf,
                            restir_pt_flags(i + 1, i, true, env, lobes) |
                                RESTIR_PT_RC_SAMPLES_LIGHTS,
                            hit, direct.light.wo, direct.light.Li, segment.rc_geometry,
                            direct.light_pdf));
                    } else {
                        // the light vertex itself reconnects
                        candidates.write(restir_pt_candidate(
                            seed, contribution * roulette * direct.realized_pdf,
                            restir_pt_flags(i + 1, i + 1, true, env, light_lobe),
                            env ? Hit()
                                : scene.get_emitter_hit(direct.light.index, direct.light_point),
                            direct.light.wo, direct.light.Li, light_geometry, 0.f));
                    }
                }
            }
        }

        // 3. russian roulette, which the target function leaves out [Lin et al. 2022, 7.4]
        if (merian_restir_pt_russian_roulette && i > merian_restir_pt_roulette_depth) {
            const float survive = russian_roulette_survival(throughput);
            if (!(rng.next_float() < survive)) {
                rec.terminal(records, sp.pos);
                light_record.record(rec, records, sp.pos, i - 1, material);
                break;
            }
            throughput /= survive;
            roulette *= survive;
        }

        // 4. the scatter direction, replayable from the path's seed
        const Optional<RestirPTScatter> sampled = restir_pt_scatter(bsdf, sp, wi, random, i, rng);
        if (!sampled.hasValue) {
            rec.terminal(records, sp.pos);
            light_record.record(rec, records, sp.pos, i - 1, material);
            break;
        }
        const RestirPTScatter scatter = sampled.value;

        // 5. x_i is where the candidates after it reconnect
        if (rc.k != 0) {
            rc.throughput *= scatter.f / scatter.pdf;
        } else if (i > 1 &&
                   (hybrid ? segment.reconnects(scatter.footprint_pdf(), limit) : i == 2)) {
            rc.k = i;
            rc.measure = from.measure() * scatter.pdf;
            const bool rc_samples_lights =
                restir_pt_bsdf_samples_lights(bsdf) && !scatter.is_delta();
            *candidates.running = restir_pt_candidate(
                seed, float3(0),
                (restir_pt_lobes(from.lobes,
                                 restir_pt_lobe_bits(scatter.lobe, scatter.transmission))
                 << RESTIR_PT_LOBE_PREV_SHIFT) |
                    (rc_samples_lights ? RESTIR_PT_RC_SAMPLES_LIGHTS : 0u),
                hit, scatter.wo, float3(0), segment.rc_geometry, 0.f);
        }

        throughput *= scatter.f / scatter.pdf;
        from = restir_pt_from(scene, bsdf, sp, i, scatter, thresholds.roughness, false);
        rec.vertex(records, sp.pos, scatter.wo, scatter.pdf, throughput, i - 1,
                   restir_pt_record_lobe(scatter.lobe, scatter.transmission),
                   PATH_RECORD_METHOD_BSDF, material);
        light_record.record(rec, records, sp.pos, i - 1, material);

        const bool last = i + 1 >= max_length;
        hit = scene.trace_ray(scatter.ray, RAY_FLAG_NONE, merian_restir_pt_instance_mask);
        sp = scene.get_shading_point(scatter.ray, hit, RenderContext(uint16_t(i)),
                                     DefaultLODSampler(), !last);
        wi = -scatter.ray.Direction;
    }

    rec.finish(records);
    return primary_emission;
}

} // namespace merian
