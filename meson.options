# Window backends
option(
    'glfw',
    type: 'feature',
    value: 'auto',
    description: 'Enable GLFW window backend.'
)
option(
    'sdl',
    type: 'feature',
    value: 'auto',
    description: 'Enable SDL3 window backend.'
)

option(
    'performance_profiling',
    type: 'boolean',
    value: true,
    description: 'Enables profiling within the merian library'
)

option('loglevel',
    type : 'combo',
    choices : ['auto', 'info', 'debug', 'trace'],
    value : 'auto'
)

# Shader compiler
option(
    'glslang',
    type: 'feature',
    value: 'auto',
    description: 'Enable support for glslang.'
)

# Geometry and other features
option(
    'tinygltf',
    type: 'feature',
    value: 'auto',
    description: 'Build with tinygltf support.'
)
option(
    'ufbx',
    type: 'feature',
    value: 'auto',
    description: 'Build with ufbx (FBX) support.'
)
option(
    'pbrt',
    type: 'feature',
    value: 'auto',
    description: 'Build with pbrt-v4 scene support (needs miniply and zlib).'
)
option(
    'tinybvh',
    type: 'feature',
    value: 'auto',
    description: 'Build with tinybvh support.'
)
option(
    'dlss',
    type: 'feature',
    value: 'auto',
    description: 'Build with NVIDIA DLSS support. auto uses an NGX SDK that is already present; enabled downloads it (717 MB, proprietary license).'
)

option(
    'ffmpeg',
    type: 'feature',
    value: 'auto',
    description: 'Build with FFmpeg video read/write nodes using Vulkan hardware en-/decoding.'
)

# Tests
option(
    'tests',
    type: 'boolean',
    value: false,
    description: 'Build and register tests.'
)

