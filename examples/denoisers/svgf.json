{
    "nodes": {
        "accumulate": {
            "enabled": true,
            "outputs": [
                "history->svgf.history",
                "out->svgf.src"
            ],
            "properties": {
                "ipr factor": 50.0,
                "adaptivity": 0.95,
                "adaptivity ipr factor": 1.5,
                "adaptivity percentile lower": 0.05000000074505806,
                "adaptivity percentile upper": 0.949999988079071,
                "alpha": 0.95,
                "depth threshold": 0.05,
                "events": {
                    "clear": "/user/clear"
                },
                "extended search": true,
                "filter mode": "stochastic bilinear",
                "firefly filter bias": 0.20000000298023224,
                "firefly filter enable": true,
                "firefly percentile lower": 0.25,
                "firefly percentile upper": 0.8999999761581421,
                "gbuffer check": "always",
                "hard clamp": "inf",
                "max history": "inf",
                "normal threshold": 35.0,
                "reuse border": false,
                "use motion vectors": true
            },
            "type": "Accumulate"
        },
        "gbuffer": {
            "$+$outputs": [
                "gbuffer->accumulate.gbuffer",
                "gbuffer->svgf.gbuffer"
            ]
        },
        "render": {
            "$+$outputs": [
                "irradiance->accumulate.src"
            ],
            "properties": {
                "output": {
                    "demodulate albedo": true
                }
            }
        },
        "svgf": {
            "enabled": true,
            "outputs": [
                "out->exposure.src"
            ],
            "properties": {
                "iterations": 5,
                "taa": {
                    "alpha": 0.9
                }
            },
            "type": "Denoiser (SVGF)"
        }
    }
}
