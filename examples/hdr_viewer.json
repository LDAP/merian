{
    "cli": {
        "--": {
            "pointer": "/nodes/image/properties/path",
            "required": true
        }
    },
    "include": [
        "parts/mixins.json"
    ],
    "nodes": {
        "display": {
            "enabled": true,
            "type": "Swapchain Blit"
        },
        "image": {
            "enabled": true,
            "outputs": [
                "out->tonemap.src"
            ],
            "properties": {
                "path": ""
            },
            "type": "HDR Image Source"
        },
        "output": {
            "enabled": true,
            "outputs": [
                "canvas->display.canvas"
            ],
            "properties": {
                "backend": "auto",
                "on close": {
                    "remove node": false,
                    "send event": true
                },
                "present mode": "Fifo"
            },
            "type": "Window"
        },
        "tonemap": {
            "enabled": true,
            "outputs": [
                "out->display.src"
            ],
            "properties": {
                "exposure bias": 2.0,
                "tonemap": "Uncharted 2"
            },
            "type": "Tonemap"
        }
    },
    "version": 4
}
