{
    "cli": {
        "--": {
            "pointer": "/nodes/shadertoy/properties/shader path",
            "required": true
        }
    },
    "include": [
        "parts/mixins.json"
    ],
    "nodes": {
        "display": {
            "enabled": true,
            "type": "Swapchain Blit"
        },
        "output": {
            "enabled": true,
            "outputs": [
                "canvas->display.canvas",
                "controller->shadertoy.controller"
            ],
            "properties": {
                "backend": "auto",
                "on close": {
                    "remove node": false,
                    "send event": true
                },
                "present mode": "Immediate"
            },
            "type": "Window"
        },
        "shadertoy": {
            "enabled": true,
            "outputs": [
                "out->display.src"
            ],
            "properties": {
                "height": 720,
                "shader path": "",
                "shader source": "file",
                "width": 1280
            },
            "type": "Shadertoy"
        }
    },
    "version": 4
}
