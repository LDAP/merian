{
    "cli": {
        "--": {
            "pointer": "/nodes/video/properties/path",
            "required": true
        }
    },
    "include": [
        "parts/mixins.json"
    ],
    "nodes": {
        "display": {
            "enabled": true,
            "type": "Swapchain Blit"
        },
        "output": {
            "enabled": true,
            "outputs": [
                "canvas->display.canvas"
            ],
            "properties": {
                "on close": {
                    "remove node": false,
                    "send event": true
                },
                "present mode": "Fifo"
            },
            "type": "Window"
        },
        "tonemap": {
            "enabled": true,
            "outputs": [
                "out->display.src"
            ],
            "properties": {
                "tonemap": "Clamp"
            },
            "type": "Tonemap"
        },
        "video": {
            "enabled": true,
            "outputs": [
                "out->tonemap.src"
            ],
            "properties": {
                "loop": true,
                "path": ""
            },
            "type": "Video Source"
        }
    },
    "version": 4
}
