{
    "nodes": {
        "display": {
            "type": "Path Debugger"
        },
        "gbuffer": {
            "$+$outputs": [
                "gbuffer->display.gbuffer"
            ]
        },
        "output": {
            "$+$outputs": [
                "controller->display.controller",
                "window->display.window"
            ]
        },
        "render": {
            "$+$outputs": [
                "path_records->display.records"
            ]
        },
        "scene": {
            "$+$outputs": [
                "scene->display.scene"
            ]
        }
    }
}
