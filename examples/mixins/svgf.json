{
    "nodes": {
        "accumulate": {
            "outputs": [
                "history->accumulate.prev_history",
                "history->svgf.history",
                "out->accumulate.prev_out",
                "out->svgf.src"
            ],
            "properties": {
                "gbuffer check": "always",
                "normal threshold": 35.0,
                "depth threshold": 0.05,
                "alpha": 0.95,
                "clear event pattern": "/user/clear",
                "filter mode": "stochastic bilinear",
                "firefly filter enable": true,
                "adaptivity": 0.95
            }
        },
        "gbuffer": {
            "$+$outputs": [
                "gbuffer->svgf.gbuffer"
            ]
        },
        "render": {
            "properties": {
                "demodulate albedo": true
            }
        },
        "svgf": {
            "outputs": [
                "out->exposure.src",
                "out->svgf.prev_out"
            ],
            "properties": {
                "SVGF iterations": 5,
                "TAA alpha": 0.9
            },
            "type": "Denoiser (SVGF)"
        }
    }
}
