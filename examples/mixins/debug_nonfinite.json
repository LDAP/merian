{
    "include": [
        "debug.json"
    ],
    "nodes": {
        "display": {
            "properties": {
                "selection": {
                    "contribution": "NaN or infinite only",
                    "restrict to": "nothing"
                },
                "overlay": {
                    "keep": "most recent",
                    "max paths": 64,
                    "color": "bounces",
                    "alpha": 0.9
                },
                "heat": {
                    "mode": "density",
                    "paths from": "selection A"
                },
                "maps": {
                    "show panels": false
                }
            }
        }
    }
}
